{%- liquid
  assign instagram_url = section.settings.instagram_url
  if instagram_url == blank
    assign instagram_url = settings.footer_instagram_url
  endif
-%}

<section
  class="password-page{% if section.settings.background_image != blank %} password-page--has-image{% endif %}"
  style="--password-background: {{ section.settings.background_color }}; --password-text: {{ section.settings.text_color }}; --password-accent: {{ section.settings.form_accent_color }}; --password-overlay: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};"
  data-password-page
>
  {%- if section.settings.background_image != blank -%}
    <picture class="password-page__background" aria-hidden="true">
      {%- if section.settings.mobile_background_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ section.settings.mobile_background_image | image_url: width: 1100 }}"
        >
      {%- endif -%}
      {{ section.settings.background_image
        | image_url: width: 2600
        | image_tag:
          widths: '900, 1400, 1900, 2600',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    </picture>
    <div class="password-page__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <header class="password-page__header">
    <button class="password-page__access" type="button" data-password-open aria-haspopup="dialog">
      <span>Enter with password</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h13M14 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </header>

  <main class="password-page__main" id="PasswordMain">
    <div class="password-page__content">
      <h1 class="password-page__heading">{{ section.settings.heading | escape }}</h1>

      {%- form 'customer', id: 'PasswordNewsletter', class: 'password-newsletter' -%}
        <input type="hidden" name="contact[tags]" value="prospect, password page">

        {%- if form.posted_successfully? -%}
          <p class="password-newsletter__success" tabindex="-1" autofocus>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 12.5 4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.success_message | escape }}
          </p>
        {%- else -%}
          <div class="password-newsletter__fields">
            <label class="password-visually-hidden" for="PasswordNewsletterEmail">Email address</label>
            <input
              id="PasswordNewsletterEmail"
              class="password-newsletter__input"
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              placeholder="{{ section.settings.email_placeholder | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="PasswordNewsletterError"{% endif %}
            >
            <button class="password-newsletter__button" type="submit">
              <span>{{ section.settings.email_button | escape }}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13M14 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

          {%- if form.errors -%}
            <div class="password-newsletter__error" id="PasswordNewsletterError" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      <p class="password-page__privacy">Private launch notes only. No noise.</p>
    </div>
  </main>

  <footer class="password-page__footer">
    <div class="password-page__footer-meta">
      {%- if section.settings.show_instagram and instagram_url != blank -%}
        <a class="password-page__social" href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer">
          {{ section.settings.instagram_label | escape }}
          <span aria-hidden="true">@caelinajewelry</span>
        </a>
      {%- else -%}
        <span></span>
      {%- endif -%}
      <p class="password-page__launch-note">Opening soon <span aria-hidden="true">—</span> 2027</p>
    </div>

    {%- if section.settings.show_footer_wordmark -%}
      <div class="password-page__footer-brand" aria-hidden="true">
        <span class="password-page__footer-wordmark">CΛELINΛ</span>
      </div>
    {%- endif -%}
  </footer>

  <dialog class="password-dialog" data-password-dialog aria-labelledby="PasswordDialogTitle">
    <div class="password-dialog__inner">
      <button class="password-dialog__close" type="button" data-password-close aria-label="Close password entry">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </button>

      <p class="password-dialog__eyebrow">Private access</p>
      <h2 class="password-dialog__title" id="PasswordDialogTitle">Enter the world of CAELINA</h2>
      <p class="password-dialog__body">If you have been given a store password, enter it below.</p>

      {%- form 'storefront_password', class: 'password-access-form' -%}
        <label class="password-visually-hidden" for="StorePassword">Store password</label>
        <div class="password-access-form__fields">
          <input
            id="StorePassword"
            class="password-access-form__input"
            type="password"
            name="password"
            placeholder="Password"
            autocomplete="current-password"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="StorePasswordError"{% endif %}
          >
          <button class="password-access-form__button" type="submit">Enter</button>
        </div>
        {%- if form.errors -%}
          <div class="password-access-form__error" id="StorePasswordError" role="alert" data-password-error>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </dialog>
</section>

{% schema %}
{
  "name": "Coming soon page",
  "tag": "section",
  "class": "password-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something beautiful is coming."
    },
    {
      "type": "header",
      "content": "Email signup"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "email_button",
      "label": "Button label",
      "default": "Join the list"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're on the list. We'll be in touch soon."
    },
    {
      "type": "header",
      "content": "Artwork and background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Leave empty to use the warm minimal background."
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image",
      "info": "Optional. Used only when a desktop background image is selected."
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "show_footer_wordmark",
      "label": "Show oversized CAELINA wordmark",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f4efe5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#14243a"
    },
    {
      "type": "color",
      "id": "form_accent_color",
      "label": "Form accent color",
      "default": "#14243a"
    },
    {
      "type": "header",
      "content": "Social link"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram link",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL",
      "info": "Uses the theme's footer Instagram link when left empty."
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Instagram label",
      "default": "Follow the journey"
    }
  ]
}
{% endschema %}
