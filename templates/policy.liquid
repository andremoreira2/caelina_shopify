<section class="content-page content-page--policy policy-page">
  <div class="content-page__inner policy-page__inner">
    <header class="content-page__header">
      <h1 class="content-page__title page-title policy-page__title">{{ policy.title }}</h1>
    </header>

    <div class="content-page__content content-page__content--policy policy-page__body">
      {{ policy.body }}
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector(".policy-page__body");
    if (!root) return;

    function cleanStyles() {
      root.querySelectorAll("style").forEach((s) => s.remove());
      root.querySelectorAll("[style]").forEach((el) => el.removeAttribute("style"));
    }

    cleanStyles();
    document.addEventListener("DOMContentLoaded", cleanStyles);
    setTimeout(cleanStyles, 500);
  })();
</script>
