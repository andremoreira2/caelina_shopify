<style>
  .policy-page,
  .policy-page .content-page__inner,
  .policy-page .content-page__header,
  .policy-page .content-page__title,
  .policy-page .content-page__content,
  .policy-page__body {
    color: #1a1a1a !important;
    opacity: 1 !important;
    -webkit-text-fill-color: #1a1a1a !important;
  }

  .policy-page__title {
    -webkit-text-fill-color: #15161a !important;
    color: #15161a !important;
  }

  .policy-page__body,
  .policy-page__body p,
  .policy-page__body li,
  .policy-page__body td,
  .policy-page__body th,
  .policy-page__body div,
  .policy-page__body span,
  .policy-page__body strong,
  .policy-page__body b,
  .policy-page__body em,
  .policy-page__body i,
  .policy-page__body blockquote,
  .policy-page__body dd,
  .policy-page__body dt {
    color: #30333a !important;
    -webkit-text-fill-color: #30333a !important;
    opacity: 1 !important;
  }

  .policy-page__body h1,
  .policy-page__body h2,
  .policy-page__body h3,
  .policy-page__body h4,
  .policy-page__body h5,
  .policy-page__body h6 {
    color: #15161a !important;
    -webkit-text-fill-color: #15161a !important;
    opacity: 1 !important;
  }

  .policy-page__body a {
    color: #111111 !important;
    -webkit-text-fill-color: #111111 !important;
  }
</style>

<section class="content-page content-page--policy policy-page">
  <div class="content-page__inner content-page__inner--narrow">
    <header class="content-page__header">
      <h1 class="content-page__title page-title policy-page__title">{{ policy.title }}</h1>
    </header>

    <div class="content-page__content content-page__content--policy policy-page__body">
      {{ policy.body }}
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector(".policy-page__body");
    if (!root) return;

    function cleanStyles() {
      root.querySelectorAll("style").forEach((s) => s.remove());
      root.querySelectorAll("[style]").forEach((el) => el.removeAttribute("style"));
    }

    cleanStyles();
    document.addEventListener("DOMContentLoaded", cleanStyles);
    setTimeout(cleanStyles, 500);
  })();
</script>
