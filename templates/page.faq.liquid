<section class="content-page faq-page" data-faq-page>
  <div class="content-page__inner content-page__inner--faq">
    <header class="content-page__header">
      <h1 class="content-page__title page-title">{{ page.title }}</h1>
    </header>

    <div class="faq-page__intro" data-faq-intro hidden></div>
    <div class="faq-page__list" data-faq-list hidden></div>

    <div class="content-page__content faq-page__source" data-faq-source>
      {{ page.content }}
    </div>
  </div>
</section>

<script>
  (() => {
    const initFaqPage = () => {
      const root = document.querySelector("[data-faq-page]");

      if (!root) {
        return;
      }

      const source = root.querySelector("[data-faq-source]");
      const list = root.querySelector("[data-faq-list]");
      const intro = root.querySelector("[data-faq-intro]");

      if (!source || !list || !intro) {
        return;
      }

      const blocks = Array.from(source.children);

      if (!blocks.length) {
        return;
      }

      const introNodes = [];
      const entries = [];
      let currentEntry = null;

      blocks.forEach((block) => {
        const tagName = block.tagName.toUpperCase();

        if (tagName === "H2") {
          currentEntry = {
            question: block.textContent.trim(),
            answerNodes: [],
          };
          entries.push(currentEntry);
          return;
        }

        if (currentEntry) {
          currentEntry.answerNodes.push(block.cloneNode(true));
          return;
        }

        introNodes.push(block.cloneNode(true));
      });

      const validEntries = entries.filter((entry) => entry.question && entry.answerNodes.length);

      if (!validEntries.length) {
        return;
      }

      if (introNodes.length) {
        introNodes.forEach((node) => intro.appendChild(node));
        intro.hidden = false;
      }

      const fragment = document.createDocumentFragment();

      validEntries.forEach((entry, index) => {
        const item = document.createElement("div");
        item.className = "accordion-item faq-page__item";

        const question = document.createElement("button");
        question.className = "accordion-header faq-page__question";
        question.type = "button";
        question.id = `faq-accordion-header-${index + 1}`;
        question.setAttribute("aria-expanded", "false");
        question.setAttribute("aria-controls", `faq-accordion-panel-${index + 1}`);

        const questionText = document.createElement("span");
        questionText.className = "faq-page__question-text";
        questionText.textContent = entry.question;

        const icon = document.createElement("span");
        icon.className = "accordion-icon faq-page__icon";
        icon.setAttribute("aria-hidden", "true");

        question.append(questionText, icon);

        const answer = document.createElement("div");
        answer.className = "accordion-content faq-page__answer";
        answer.id = `faq-accordion-panel-${index + 1}`;
        answer.setAttribute("role", "region");
        answer.setAttribute("aria-labelledby", question.id);
        entry.answerNodes.forEach((node) => answer.appendChild(node));

        item.append(question, answer);
        fragment.appendChild(item);
      });

      list.appendChild(fragment);
      list.hidden = false;
      source.hidden = true;

      const accordionHeaders = Array.from(list.querySelectorAll(".faq-page__question"));

      const getAccordionContent = (header) => {
        const content = header.nextElementSibling;
        return content instanceof HTMLElement ? content : null;
      };

      const openAccordion = (header) => {
        const content = getAccordionContent(header);
        if (!content || header.getAttribute("aria-expanded") === "true") return;

        content.style.paddingBottom = "0px";
        content.classList.add("is-open");
        content.setAttribute("aria-hidden", "false");
        header.setAttribute("aria-expanded", "true");

        content.style.height = "auto";
        content.style.paddingBottom = "";
        const endHeight = content.getBoundingClientRect().height;

        content.style.height = "0px";
        content.style.paddingBottom = "0px";
        void content.offsetHeight;

        requestAnimationFrame(() => {
          content.style.height = `${endHeight}px`;
          content.style.paddingBottom = "";
        });
      };

      const closeAccordion = (header) => {
        const content = getAccordionContent(header);
        if (!content || header.getAttribute("aria-expanded") !== "true") return;

        content.style.paddingBottom = getComputedStyle(content).paddingBottom;
        content.style.height = `${content.getBoundingClientRect().height}px`;
        void content.offsetHeight;

        content.classList.remove("is-open");
        content.setAttribute("aria-hidden", "true");
        header.setAttribute("aria-expanded", "false");

        requestAnimationFrame(() => {
          content.style.height = "0px";
          content.style.paddingBottom = "0px";
        });
      };

      accordionHeaders.forEach((header) => {
        const content = getAccordionContent(header);
        if (!content) return;

        content.setAttribute("aria-hidden", "true");
        content.style.height = "0px";

        content.addEventListener("transitionend", (event) => {
          if (event.propertyName !== "height") return;
          if (header.getAttribute("aria-expanded") !== "true") {
            content.style.height = "0px";
            content.style.paddingBottom = "";
          }
        });

        header.addEventListener("click", () => {
          const isOpen = header.getAttribute("aria-expanded") === "true";

          accordionHeaders.forEach((otherHeader) => {
            if (otherHeader !== header) {
              closeAccordion(otherHeader);
            }
          });

          if (isOpen) {
            closeAccordion(header);
            return;
          }

          openAccordion(header);
        });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initFaqPage, { once: true });
      return;
    }

    initFaqPage();
  })();
</script>
