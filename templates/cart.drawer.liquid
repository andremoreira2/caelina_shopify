{% layout none %}

<div class="drawer-cart">
  <div class="drawer-cart__header-banner">
    Use coupon code <strong>WELCOME10</strong> for 10% off your first order.
  </div>

  <div class="drawer-cart__header">
    <h2 class="drawer-cart__title">Cart ({{ cart.item_count }})</h2>
    <button class="drawer-cart__close" type="button" data-cart-drawer-close aria-label="Close cart">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="drawer-cart__shipping" data-shipping-bar>
    <div class="drawer-cart__shipping-text" data-shipping-text>You are $100 away from free shipping.</div>
    <div class="drawer-cart__shipping-progress">
      <div class="drawer-cart__shipping-fill" data-shipping-fill style="width: 0%"></div>
    </div>
  </div>

  {% if cart.item_count == 0 %}
    <div class="drawer-cart__empty">Your cart is empty.</div>
    <a class="btn" href="/collections/all">Explore products</a>
  {% else %}
    <div class="drawer-cart__body">
      <ul class="drawer-cart__lines">
        {% for item in cart.items %}
          <li class="drawer-cart__line" data-cart-line data-key="{{ item.key }}">
            <a class="drawer-cart__line-image" href="{{ item.url }}">
              {% if item.image %}
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.image.alt | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </a>

            <div class="drawer-cart__line-details">
              <div class="drawer-cart__line-header">
                <a class="drawer-cart__name" href="{{ item.url }}">{{ item.product.title }}</a>
                {% render 'price',
                  amount: item.final_price,
                  wrapper_class: 'drawer-cart__price price--compact'
                %}
              </div>

              {% if item.variant.title != 'Default Title' %}
                <div class="drawer-cart__variant">Color: {{ item.variant.title }}</div>
                {% render 'price',
                  amount: item.final_price,
                  wrapper_class: 'drawer-cart__variant-price price--compact'
                %}
              {% endif %}

              <div class="drawer-cart__controls">
                <div class="drawer-cart__qty-wrapper">
                  {% assign max_quantity = item.quantity %}
                  {% if max_quantity < 10 %}
                    {% assign max_quantity = 10 %}
                  {% endif %}
                  <select class="drawer-cart__qty-select" data-qty-input>
                    {% for i in (1..max_quantity) %}
                      <option value="{{ i }}" {% if item.quantity == i %}selected{% endif %}>{{ i }}</option>
                    {% endfor %}
                  </select>
                  <svg class="drawer-cart__qty-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor">
                    <path d="M1 1L5 5L9 1" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>

                <button class="drawer-cart__remove" type="button" data-remove>REMOVE</button>
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>

      <!-- Complementary upsell populated client-side when Shopify returns matches -->
      <div class="drawer-cart__upsell" data-upsell-container style="display: none;">
        <h3 class="drawer-cart__upsell-title" data-upsell-title>Pair it with</h3>
        <div class="drawer-cart__upsell-item" data-upsell-item></div>
      </div>
    </div>

    <div class="drawer-cart__footer">
      <div class="drawer-cart__subtotal">
        <span>SUBTOTAL</span>
        {% render 'price',
          amount: cart.total_price,
          wrapper_tag: 'span',
          wrapper_class: 'drawer-cart__subtotal-price price--subtotal',
          current_suffix: ' USD'
        %}
      </div>
      <div class="drawer-cart__actions">
        <button class="btn btn--block btn--checkout" type="submit" name="checkout" onclick="window.location.href='/checkout'">
          <span class="btn--checkout__content">
            <span class="btn--checkout__label">CHECKOUT SECURELY</span>
            <span class="btn--checkout__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false">
                <path fill="currentColor" d="M8 1.75A2.75 2.75 0 0 0 5.25 4.5V7H4a1 1 0 0 0-1 1v5.25a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-1.25V4.5A2.75 2.75 0 0 0 8 1.75Zm1.25 5.25h-2.5V4.5a1.25 1.25 0 1 1 2.5 0V7Zm-1.9 2.25h1.3c.11 0 .2.09.2.2v.72c0 .07.04.14.09.18.3.22.49.57.49.97A1.43 1.43 0 0 1 8 12.75a1.43 1.43 0 0 1-1.43-1.43c0-.4.19-.75.49-.97a.22.22 0 0 0 .09-.18v-.72c0-.11.09-.2.2-.2Z"/>
              </svg>
            </span>
          </span>
        </button>
        <div class="drawer-cart__disclaimer">Shipping, taxes, and discount codes are calculated at checkout</div>
      </div>
    </div>
  {% endif %}
</div>
