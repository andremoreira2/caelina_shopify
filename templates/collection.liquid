{% assign collection_min_price = 0 %}
{% assign collection_min_price_raw = 0 %}
{% for product in collection.products limit: 50 %}
  {% assign p_price = product.price | money_without_currency | replace: ',', '' | plus: 0 %}
  {% if forloop.first or p_price < collection_min_price %}
    {% assign collection_min_price = p_price %}
    {% assign collection_min_price_raw = product.price %}
  {% endif %}
{% endfor %}

{% paginate collection.products by 24 %}
  {% assign active_filter_count = 0 %}
  {% assign current_sort_value = collection.sort_by | default: collection.default_sort_by %}
  {% assign current_sort_label = collection.sort_options.first.name %}
  {% assign sort_toggle_label = 'Sort by' %}

  {% for option in collection.sort_options %}
    {% if option.value == current_sort_value %}
      {% assign current_sort_label = option.name %}
    {% endif %}
  {% endfor %}

  {% if current_sort_value != blank and current_sort_value != collection.default_sort_by %}
    {% assign sort_toggle_label = current_sort_label %}
  {% endif %}

  {% for filter in collection.filters %}
    {% if filter.type == 'price_range' %}
      {% if filter.min_value.value != blank or filter.max_value.value != blank %}
        {% assign active_filter_count = active_filter_count | plus: 1 %}
      {% endif %}
    {% else %}
      {% assign active_filter_count = active_filter_count | plus: filter.active_values.size %}
    {% endif %}
  {% endfor %}

  {%- capture clear_filters_query -%}
    {%- if current_sort_value != blank and current_sort_value != collection.default_sort_by -%}
      ?sort_by={{ current_sort_value | url_encode }}
    {%- endif -%}
  {%- endcapture -%}
  {% assign clear_filters_url = collection.url | append: clear_filters_query %}

  <section class="collection-page" data-collection-root>
    <div class="collection-loading" aria-hidden="true" data-collection-loading>
      <span class="collection-loading__bar"></span>
    </div>

    <header class="collection-header">
      <h1 class="collection-title page-title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection-description">{{ collection.description }}</div>
      {% endif %}
    </header>

    <div data-collection-content>
      <div class="collection-toolbar" data-collection-toolbar>
        <div class="collection-toolbar__meta">
          <button
            type="button"
            class="collection-toolbar__button collection-toolbar__button--filters"
            data-filter-open
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="CollectionFilterDrawer"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <span>Filters{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}</span>
          </button>

          <span class="collection-toolbar__divider" aria-hidden="true"></span>

          <details class="collection-sort" data-collection-sort data-default-sort-value="{{ collection.default_sort_by | escape }}">
            <summary
              class="collection-toolbar__button collection-toolbar__button--sort"
              aria-label="Sort by. Current option: {{ sort_toggle_label | escape }}"
            >
              <span class="collection-toolbar__sort-label" data-collection-sort-label data-default-label="Sort by">{{ sort_toggle_label }}</span>
              <span class="collection-toolbar__chevron" aria-hidden="true"></span>
            </summary>

            <form class="collection-sort__panel" method="get" action="{{ collection.url }}">
              {% for filter in collection.filters %}
                {% if filter.type == 'price_range' %}
                  {% if filter.min_value.value != blank %}
                    <input
                      type="hidden"
                      name="{{ filter.min_value.param_name }}"
                      value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                    >
                  {% endif %}
                  {% if filter.max_value.value != blank %}
                    <input
                      type="hidden"
                      name="{{ filter.max_value.param_name }}"
                      value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                    >
                  {% endif %}
                {% else %}
                  {% for value in filter.active_values %}
                    <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
                  {% endfor %}
                {% endif %}
              {% endfor %}

              <fieldset class="collection-sort__options">
                <legend class="visually-hidden">Sort products</legend>
                {% for option in collection.sort_options %}
                  <label class="collection-sort__option">
                    <input
                      type="radio"
                      name="sort_by"
                      value="{{ option.value }}"
                      {% if option.value == current_sort_value %}checked{% endif %}
                    >
                    <span class="collection-sort__option-label">{{ option.name }}</span>
                  </label>
                {% endfor %}
              </fieldset>
            </form>
          </details>
        </div>

        <span class="collection-toolbar__count">Showing {{ paginate.items }} item{% if paginate.items != 1 %}s{% endif %}</span>
      </div>

      <div
        class="collection-filter-drawer"
        id="CollectionFilterDrawer"
        data-filter-drawer
        hidden
      >
        <button
          type="button"
          class="collection-filter-drawer__backdrop"
          data-filter-close
          aria-label="Close filters"
        ></button>

        <div
          class="collection-filter-drawer__panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="CollectionFilterDrawerTitle"
        >
          <form class="collection-filter-form" method="get" action="{{ collection.url }}">
            {% if current_sort_value != blank %}
              <input type="hidden" name="sort_by" value="{{ current_sort_value }}">
            {% endif %}

            <div class="collection-filter-drawer__body">
              <header class="collection-filter-drawer__header">
                <h2 id="CollectionFilterDrawerTitle" class="collection-filter-drawer__title">
                  Filters{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}
                </h2>

                <button
                  type="button"
                  class="collection-filter-drawer__close"
                  data-filter-close
                  aria-label="Close filters"
                >
                  <span aria-hidden="true">&times;</span>
                </button>
              </header>

              {% if active_filter_count > 0 %}
                <div class="collection-filter-drawer__active">
                  <a class="collection-filter-chip collection-filter-chip--clear" href="{{ clear_filters_url }}">
                    Clear filters
                  </a>

                  {% for filter in collection.filters %}
                    {% if filter.type == 'price_range' %}
                      {% if filter.min_value.value != blank or filter.max_value.value != blank %}
                        <a class="collection-filter-chip" href="{{ filter.url_to_remove }}">
                          {% if filter.min_value.value != blank %}{{ filter.min_value.value | money }}{% else %}{{ collection_min_price_raw | money }}{% endif %}
                          -
                          {% if filter.max_value.value != blank %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %}
                        </a>
                      {% endif %}
                    {% else %}
                      {% for value in filter.active_values %}
                        <a class="collection-filter-chip" href="{{ value.url_to_remove }}">{{ value.label }}</a>
                      {% endfor %}
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              <div class="collection-filter-drawer__groups">
                {% if collection.filters.size > 0 %}
                  {% for filter in collection.filters %}
                    {% assign group_active_count = 0 %}
                    {% if filter.type == 'price_range' %}
                      {% if filter.min_value.value != blank or filter.max_value.value != blank %}
                        {% assign group_active_count = 1 %}
                      {% endif %}
                    {% else %}
                      {% assign group_active_count = filter.active_values.size %}
                    {% endif %}

                    <details class="collection-filter-group" {% if group_active_count > 0 %}open{% endif %}>
                      <summary class="collection-filter-group__summary">
                        <span class="collection-filter-group__label">{{ filter.label }}</span>
                        <span class="collection-filter-group__meta">
                          {% if group_active_count > 0 %}
                            <span class="collection-filter-group__count">{{ group_active_count }}</span>
                          {% endif %}
                          <span class="collection-filter-group__icon" aria-hidden="true"></span>
                        </span>
                      </summary>

                      <div class="collection-filter-group__content">
                        <div class="collection-filter-group__inner">
                          {% case filter.type %}
                            {% when 'price_range' %}
                              {% assign price_range_max = filter.range_max | money_without_currency | replace: ',', '' | plus: 0 %}
                              {% assign price_range_min = collection_min_price %}
                              <div class="filter-range" data-price-range>
                                <div class="filter-range__slider" data-price-slider>
                                  <span class="filter-range__slider-track" aria-hidden="true"></span>
                                  <span class="filter-range__slider-fill" aria-hidden="true"></span>
                                  <input
                                    class="filter-range__slider-input filter-range__slider-input--min"
                                    type="range"
                                    min="{{ price_range_min }}"
                                    max="{{ price_range_max }}"
                                    step="1"
                                    value="{% if filter.min_value.value != blank %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% else %}{{ price_range_min }}{% endif %}"
                                    data-price-slider-input="min"
                                    aria-label="Minimum price"
                                  >
                                  <input
                                    class="filter-range__slider-input filter-range__slider-input--max"
                                    type="range"
                                    min="{{ price_range_min }}"
                                    max="{{ price_range_max }}"
                                    step="1"
                                    value="{% if filter.max_value.value != blank %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% else %}{{ price_range_max }}{% endif %}"
                                    data-price-slider-input="max"
                                    aria-label="Maximum price"
                                  >
                                </div>

                                <div class="filter-range__fields">
                                  <input
                                    class="filter-input"
                                    type="number"
                                    name="{{ filter.min_value.param_name }}"
                                    value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                                    placeholder="{{ price_range_min }}"
                                    min="{{ price_range_min }}"
                                    max="{{ price_range_max }}"
                                    data-price-input="min"
                                  >
                                  <span class="filter-range__dash">—</span>
                                  <input
                                    class="filter-input"
                                    type="number"
                                    name="{{ filter.max_value.param_name }}"
                                    value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                                    placeholder="{{ price_range_max }}"
                                    min="{{ price_range_min }}"
                                    max="{{ price_range_max }}"
                                    data-price-input="max"
                                  >
                                </div>

                                <button
                                  type="submit"
                                  class="filter-range__apply"
                                  data-price-apply
                                  disabled
                                  aria-disabled="true"
                                >
                                  Apply
                                </button>
                              </div>
                            {% else %}
                              <ul class="filter-list">
                                {% for value in filter.values %}
                                  <li>
                                    <label class="filter-item{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                                      <input
                                        type="checkbox"
                                        name="{{ value.param_name }}"
                                        value="{{ value.value }}"
                                        {% if value.active %}checked{% endif %}
                                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                      >
                                      <span>{{ value.label }}{% if value.count >= 0 %} ({{ value.count }}){% endif %}</span>
                                    </label>
                                  </li>
                                {% endfor %}
                              </ul>
                          {% endcase %}
                        </div>
                      </div>
                    </details>
                  {% endfor %}
                {% else %}
                  <div class="filter-empty">No filters available yet.</div>
                {% endif %}
              </div>
            </div>

            <div class="collection-filter-drawer__footer">
              <a class="collection-filter-drawer__reset" href="{{ clear_filters_url }}">Reset</a>
              <button type="submit" class="collection-filter-drawer__apply">
                View {{ paginate.items }} item{% if paginate.items != 1 %}s{% endif %}
              </button>
            </div>
          </form>
        </div>
      </div>

      <div data-collection-results>
        <div class="collection-grid">
          {% if paginate.items == 0 or collection.products.size == 0 %}
            <div class="collection-empty">No products found in this collection.</div>
          {% else %}
            {% for product in collection.products %}
              {% assign quick_add_variant = product.selected_or_first_available_variant | default: product.variants.first %}
              {% assign product_image_count = product.images | size %}
              <article class="collection-card">
                <div class="collection-card__media">
                  {% if product.available == false %}
                    <span class="collection-card__badge">Sold out</span>
                  {% endif %}

                  <a class="collection-card__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                    <div class="collection-card__image-wrapper">
                      {% if product.featured_image %}
                        <img
                          src="{{ product.featured_image | image_url: width: 600 }}"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          width="{{ product.featured_image.width }}"
                          height="{{ product.featured_image.height }}"
                          loading="lazy"
                          data-collection-card-image
                        >
                      {% endif %}
                    </div>
                  </a>

                  {% if product_image_count > 1 %}
                    <div class="collection-card__nav" data-collection-card-nav aria-hidden="true">
                      <button
                        type="button"
                        class="collection-card__nav-button collection-card__nav-button--prev"
                        data-collection-card-prev
                        aria-label="Show previous image for {{ product.title | escape }}"
                      >
                        <svg class="collection-card__nav-icon" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8.91003 19.9201L15.43 13.4001C16.2 12.6301 16.2 11.3701 15.43 10.6001L8.91003 4.08008" class="collection-card__nav-arrow"></path>
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="collection-card__nav-button collection-card__nav-button--next"
                        data-collection-card-next
                        aria-label="Show next image for {{ product.title | escape }}"
                      >
                        <svg class="collection-card__nav-icon" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8.91003 19.9201L15.43 13.4001C16.2 12.6301 16.2 11.3701 15.43 10.6001L8.91003 4.08008" class="collection-card__nav-arrow"></path>
                        </svg>
                      </button>
                    </div>
                    <div
                      class="collection-card__gallery-progress"
                      data-collection-card-progress
                      aria-hidden="true"
                      style="--collection-card-gallery-count: {{ product_image_count }};"
                    >
                      <span class="collection-card__gallery-progress-thumb"></span>
                    </div>
                    <script type="application/json" data-collection-card-images>
                      [
                        {% for product_image in product.images %}
                          {
                            "src": {{ product_image | image_url: width: 600 | json }},
                            "alt": {{ product_image.alt | default: product.title | json }},
                            "width": {{ product_image.width | json }},
                            "height": {{ product_image.height | json }}
                          }{% unless forloop.last %},{% endunless %}
                        {% endfor %}
                      ]
                    </script>
                  {% endif %}

                  <div class="collection-card__actions">
                    {% if product.available == false %}
                      <button
                        type="button"
                        class="btn btn--atc collection-card__quick-add"
                        aria-label="Sold out: {{ product.title | escape }}"
                        disabled
                      >
                        <span class="btn-text">Sold out</span>
                      </button>
                    {% elsif product.variants.size == 1 and quick_add_variant %}
                      {% form 'product', product, class: 'collection-card__quick-add-form' %}
                        <input type="hidden" name="id" value="{{ quick_add_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button
                          type="submit"
                          class="btn btn--atc collection-card__quick-add"
                          aria-label="Add {{ product.title | escape }} to cart"
                        >
                          <span class="btn-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                            </svg>
                          </span>
                          <span class="btn-text">Add to cart</span>
                        </button>
                      {% endform %}
                    {% else %}
                      <a
                        class="btn btn--atc collection-card__quick-add collection-card__quick-add--link"
                        href="{{ product.url }}"
                        aria-label="Choose options for {{ product.title | escape }}"
                      >
                        <span class="btn-icon" aria-hidden="true">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                          </svg>
                        </span>
                        <span class="btn-text">Choose options</span>
                      </a>
                    {% endif %}
                  </div>
                </div>

                <a class="collection-card__info" href="{{ product.url }}">
                  <span class="collection-card__title">{{ product.title }}</span>
                  {% render 'price',
                    amount: product.price,
                    wrapper_tag: 'span',
                    wrapper_class: 'collection-card__price price--card'
                  %}
                </a>
              </article>
            {% endfor %}
          {% endif %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="collection-pagination" role="navigation" aria-label="Pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}">Prev</a>
            {% endif %}
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}">Next</a>
            {% endif %}
          </nav>
        {% endif %}
      </div>
    </div>
  </section>

  <script src="{{ 'collection-toolbar.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'collection-card-gallery.js' | asset_url }}" defer="defer"></script>
{% endpaginate %}
