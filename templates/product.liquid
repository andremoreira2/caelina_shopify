<section class="product-page">
  <h1 class="product-title product-title--mobile">{{ product.title }}</h1>
  <div class="product-media">
    {% assign gallery_images = product.media | where: "media_type", "image" %}
    {% assign image_count = gallery_images.size %}
    {% assign image_remainder = image_count | modulo: 2 %}
    <div class="product-gallery-grid{% if image_count > 1 and image_remainder == 1 %} product-gallery-grid--odd{% endif %}">
      {% for media in gallery_images %}
        <button
          class="product-gallery-grid__item"
          type="button"
          data-gallery-image
          data-index="{{ forloop.index0 }}"
          data-zoom="{{ media | image_url: width: 2200 }}"
          data-alt="{{ media.alt | escape }}"
          aria-label="Open image {{ forloop.index }}"
        >
          <img
            src="{{ media | image_url: width: 1200 }}"
            alt="{{ media.alt | escape }}"
            loading="{% if forloop.index0 < 2 %}eager{% else %}lazy{% endif %}"
          >
        </button>
      {% endfor %}
    </div>
    {% if image_count == 0 %}
      <div class="product-placeholder">No images yet.</div>
    {% endif %}
  </div>

  <div class="product-info">
    {% assign current_variant = product.selected_or_first_available_variant %}
    <h1 class="product-title">{{ product.title }}</h1>
    {% render 'price',
      amount: current_variant.price,
      compare_amount: current_variant.compare_at_price,
      wrapper_class: 'product-price price--feature',
      current_class: 'product-price-value',
      compare_class: 'product-compare',
      wrapper_attrs: 'data-product-price',
      always_render_compare: true
    %}

    {% form 'product', product, class: 'product-form' %}
      {% if product.variants.size > 1 %}
        <div class="product-options" data-options>
          {% for option in product.options_with_values %}
            <div class="product-option" data-option-index="{{ forloop.index0 }}">
              <div class="product-label">{{ option.name }}</div>
              <div class="product-option__values">
                {% for value in option.values %}
                  <button
                    class="product-option__value"
                    type="button"
                    data-option-value="{{ value }}"
                    aria-pressed="false"
                  >
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
        <label class="product-label visually-hidden" for="variantSelect">Variant</label>
        <select id="variantSelect" name="id" class="product-select is-hidden" data-variant-select>
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              data-price="{{ variant.price | money }}"
              data-compare="{{ variant.compare_at_price | money }}"
              data-price-amount="{{ variant.price }}"
              data-compare-amount="{{ variant.compare_at_price }}"
              data-available="{{ variant.available }}"
              {% if variant.id == current_variant.id %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }} - {{ variant.price | money }}
            </option>
          {% endfor %}
        </select>
      {% else %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% endif %}

      <div class="product-form-row{% unless current_variant.available %} is-sold-out{% endunless %}">
        <div class="qty-wrapper" data-qty-wrapper {% unless current_variant.available %}hidden{% endunless %}>
             <label class="visually-hidden" for="quantity">Quantity</label>
             <!-- Simplified Quantity Input to match design ( - 1 + ) -->
             <div class="qty-control">
                <button type="button" class="qty-btn" data-qty-minus aria-label="Decrease quantity">&minus;</button>
                <input
                  id="quantity"
                  class="product-qty"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  max="99"
                  step="1"
                  inputmode="none"
                  readonly
                >
                <button type="button" class="qty-btn" data-qty-plus aria-label="Increase quantity">&plus;</button>
             </div>
        </div>

        <button
            type="submit"
            class="btn btn--atc"
            data-add-to-cart
            {% unless current_variant.available %}disabled{% endunless %}
        >
            <span class="btn-icon" aria-hidden="true" {% unless current_variant.available %}hidden{% endunless %}>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
              </svg>
            </span>
            <span class="btn-text">{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
        </button>
      </div>
      
      {% if current_variant.available %}
        <button type="button" class="btn secondary">Buy it now</button>
      {% endif %}

      <!-- Hidden raw description for JS parsing -->
      {% if product.description != blank %}
        <div id="product-description-raw" hidden>{{ product.description }}</div>
      {% endif %}

      <!-- Accordions -->
      <div class="product-accordions">
        <div class="accordion-item">
            <button class="accordion-header" type="button" aria-expanded="false">
                Description
                <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content" id="accordion-description">
                {% unless product.description != blank %}
                  <p>No description available.</p>
                {% endunless %}
            </div>
        </div>
        <div class="accordion-item" id="accordion-item-details">
            <button class="accordion-header" type="button" aria-expanded="false">
                Details
                <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content" id="accordion-details">
            </div>
        </div>
        <div class="accordion-item" id="accordion-item-materials">
            <button class="accordion-header" type="button" aria-expanded="false">
                Materials
                <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content" id="accordion-materials">
                {% unless product.description != blank %}
                  <p>Premium sterling silver or 14k gold vermeil.</p>
                {% endunless %}
            </div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header" type="button" aria-expanded="false">
                Care & Maintenance
                <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
                <p>Gentle cleaning with a soft cloth. Avoid harsh chemicals.</p>
            </div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header" type="button" aria-expanded="false">
                Shipping & Returns
                <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
                <p>Free shipping on orders over $100. Returns accepted within 30 days.</p>
            </div>
        </div>
      </div>
    {% endform %}

    <a class="cart-link" href="/cart">View cart</a>
  </div>
</section>

<section class="announcement__bar-outer product-announcement" aria-label="Store announcement">
  <div class="announcement__bar-holder announcement__bar-holder--marquee">
    <div class="announcement__bar" role="note">
      <div class="announcement__message">
        <div class="announcement__scale">
          <div class="announcement__text">
            {% for i in (1..6) %}
              <div class="announcement__slide">
                <p>
                  <span class="announcement__divider" aria-hidden="true">&middot;</span>
                  <span>SIGN UP &amp; GET A 35$ GIFT</span>
                  <span class="announcement__divider" aria-hidden="true">&middot;</span>
                  <span>FREE WORLDWIDE SHIPPING</span>
                </p>
              </div>
            {% endfor %}
          </div>
          <div class="announcement__text announcement__text--clone" aria-hidden="true">
            {% for i in (1..6) %}
              <div class="announcement__slide">
                <p>
                  <span class="announcement__divider" aria-hidden="true">&middot;</span>
                  <span>SIGN UP &amp; GET A 35$ GIFT</span>
                  <span class="announcement__divider" aria-hidden="true">&middot;</span>
                  <span>FREE WORLDWIDE SHIPPING</span>
                </p>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% assign floating_variant = product.selected_or_first_available_variant %}
{% assign floating_image = product.featured_image | default: product.images.first %}
<div class="product-floating-atc" data-floating-atc aria-hidden="true">
  <div class="product-floating-atc__inner">
    <div class="product-floating-atc__left">
      {% if floating_image != blank %}
        <div class="product-floating-atc__image-wrap" aria-hidden="true">
          <img
            class="product-floating-atc__image"
            src="{{ floating_image | image_url: width: 160 }}"
            alt="{{ floating_image.alt | default: product.title | escape }}"
            loading="lazy"
            width="80"
            height="80"
          >
        </div>
      {% endif %}
      <div class="product-floating-atc__meta">
        <p class="product-floating-atc__title">{{ product.title }}</p>
        {% render 'price',
          amount: floating_variant.price,
          wrapper_tag: 'p',
          wrapper_class: 'product-floating-atc__price price--compact',
          current_class: 'product-floating-atc__price-value',
          current_attrs: 'data-floating-price'
        %}
      </div>
    </div>
    <button
      type="button"
      class="btn btn--atc product-floating-atc__btn"
      data-floating-add-to-cart
      {% unless floating_variant.available %}disabled{% endunless %}
    >
      <span class="btn-icon product-floating-atc__btn-icon" data-floating-add-icon aria-hidden="true" {% unless floating_variant.available %}hidden{% endunless %}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
      </span>
      <span class="btn-text" data-floating-add-text>{% if floating_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
    </button>
  </div>
</div>

{% assign stl_enabled = product.metafields.custom.shop_the_look_enabled.value %}
{% assign stl_title = product.metafields.custom.shop_the_look_title.value | default: 'Shop The Look' %}
{% assign stl_image = product.metafields.custom.shop_the_look_image.value %}
{% assign stl_products = product.metafields.custom.shop_the_look_products.value %}
{% assign stl_hotspots = product.metafields.custom.shop_the_look_hotspots.value %}
{% assign stl_set = product.metafields.custom.shop_the_look_set.value %}

{% if stl_set != blank %}
  {% assign stl_set_title = stl_set.shop_the_look_title.value | default: stl_set.title.value | default: stl_set.shop_the_look_title | default: stl_set.title %}
  {% assign stl_set_image = stl_set.shop_the_look_image.value | default: stl_set.image.value | default: stl_set.shop_the_look_image | default: stl_set.image %}
  {% assign stl_set_products = stl_set.shop_the_look_products.value | default: stl_set.products.value | default: stl_set.shop_the_look_products | default: stl_set.products %}
  {% assign stl_set_hotspots = stl_set.shop_the_look_hotspots.value | default: stl_set.hotspots.value | default: stl_set.shop_the_look_hotspots | default: stl_set.hotspots %}

  {% if stl_set_title != blank %}
    {% assign stl_title = stl_set_title %}
  {% endif %}
  {% if stl_set_image != blank %}
    {% assign stl_image = stl_set_image %}
  {% endif %}
  {% if stl_set_products != blank %}
    {% assign stl_products = stl_set_products %}
  {% endif %}
  {% if stl_set_hotspots != blank %}
    {% assign stl_hotspots = stl_set_hotspots %}
  {% endif %}
  {% assign stl_enabled = true %}
{% endif %}
{% assign stl_product_count = 0 %}
{% if stl_products != blank %}
  {% for stl_product in stl_products limit: 4 %}
    {% if stl_product != blank %}
      {% assign stl_product_count = stl_product_count | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if stl_enabled and stl_image != blank and stl_product_count > 0 %}
  <section class="shop-the-look shop-the-look--product" data-shop-the-look>
    <div class="shop-the-look__inner">
      <div class="shop-the-look__layout">
        <div class="shop-the-look__media-column">
          <div class="shop-the-look__header">
            <h2 class="shop-the-look__title">{{ stl_title }}</h2>
          </div>
          <div class="shop-the-look__media-wrap" style="--stl-image-ratio: {{ stl_image.aspect_ratio | default: 0.8571428571 }};">
            <img
              class="shop-the-look__image"
              src="{{ stl_image | image_url: width: 1800 }}"
              alt="{{ stl_image.alt | default: stl_title | escape }}"
              loading="lazy"
              width="{{ stl_image.width | default: 1200 }}"
              height="{{ stl_image.height | default: 1400 }}"
            >
            <div class="shop-the-look__dots">
              {% assign stl_dot_index = 0 %}
              {% for stl_product in stl_products limit: 4 %}
                {% if stl_product != blank %}
                  {% assign fallback_x = 50 %}
                  {% assign fallback_y = 50 %}
                  {% case stl_dot_index %}
                    {% when 0 %}
                      {% assign fallback_x = 28 %}
                      {% assign fallback_y = 34 %}
                    {% when 1 %}
                      {% assign fallback_x = 64 %}
                      {% assign fallback_y = 30 %}
                    {% when 2 %}
                      {% assign fallback_x = 70 %}
                      {% assign fallback_y = 62 %}
                    {% when 3 %}
                      {% assign fallback_x = 48 %}
                      {% assign fallback_y = 78 %}
                  {% endcase %}

                  {% assign stl_dot_x = fallback_x %}
                  {% assign stl_dot_y = fallback_y %}
                  {% assign stl_dot_label = stl_product.title %}
                  {% if stl_hotspots != blank and stl_hotspots.size > stl_dot_index %}
                    {% assign stl_hotspot = stl_hotspots[stl_dot_index] %}
                    {% if stl_hotspot.x != blank %}
                      {% assign stl_dot_x = stl_hotspot.x %}
                    {% endif %}
                    {% if stl_hotspot.y != blank %}
                      {% assign stl_dot_y = stl_hotspot.y %}
                    {% endif %}
                    {% if stl_hotspot.label != blank %}
                      {% assign stl_dot_label = stl_hotspot.label %}
                    {% endif %}
                  {% endif %}
                  <button
                    class="shop-the-look__dot{% if stl_dot_index == 0 %} is-active{% endif %}"
                    type="button"
                    data-stl-dot
                    data-index="{{ stl_dot_index }}"
                    aria-label="Show {{ stl_dot_label | escape }}"
                    aria-pressed="{% if stl_dot_index == 0 %}true{% else %}false{% endif %}"
                    style="left: {{ stl_dot_x | at_least: 0 | at_most: 100 }}%; top: {{ stl_dot_y | at_least: 0 | at_most: 100 }}%;"
                  >
                    <span class="shop-the-look__dot-core" aria-hidden="true"></span>
                  </button>
                  {% assign stl_dot_index = stl_dot_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>

        <div class="shop-the-look__panel">
          {% assign stl_card_index = 0 %}
          {% for stl_product in stl_products limit: 4 %}
            {% if stl_product != blank %}
              {% assign stl_active = false %}
              {% if stl_card_index == 0 %}
                {% assign stl_active = true %}
              {% endif %}
              {% assign stl_variant = stl_product.selected_or_first_available_variant | default: stl_product.variants.first %}
              {% assign stl_product_image = stl_product.featured_image | default: stl_product.images.first %}
              {% capture stl_variant_select_id %}stlVariant-{{ product.id }}-{{ stl_card_index }}{% endcapture %}
              <article
                class="shop-the-look__card{% if stl_active %} is-active{% endif %}"
                data-stl-card
                data-index="{{ stl_card_index }}"
              >
                <a class="shop-the-look__card-media" href="{{ stl_product.url }}">
                  {% if stl_product_image != blank %}
                    <img
                      src="{{ stl_product_image | image_url: width: 1000 }}"
                      alt="{{ stl_product_image.alt | default: stl_product.title | escape }}"
                      loading="lazy"
                      width="{{ stl_product_image.width | default: 900 }}"
                      height="{{ stl_product_image.height | default: 900 }}"
                    >
                  {% else %}
                    <span class="shop-the-look__media-fallback" aria-hidden="true"></span>
                  {% endif %}
                </a>

                <div class="shop-the-look__card-meta">
                  {% if stl_product.vendor != blank %}
                    <p class="shop-the-look__vendor">{{ stl_product.vendor }}</p>
                  {% endif %}
                  <h3 class="shop-the-look__product-title"><a href="{{ stl_product.url }}">{{ stl_product.title }}</a></h3>
                  {% render 'price',
                    amount: stl_variant.price,
                    compare_amount: stl_variant.compare_at_price,
                    wrapper_class: 'shop-the-look__price-line price--feature',
                    current_class: 'shop-the-look__price-value',
                    compare_class: 'shop-the-look__price-compare',
                    current_attrs: 'data-stl-price',
                    compare_attrs: 'data-stl-compare',
                    always_render_compare: true
                  %}

                  <form
                    method="post"
                    action="/cart/add"
                    class="shop-the-look__form"
                    data-stl-product-title="{{ stl_product.title | escape }}"
                    data-stl-requires-choice="{% if stl_product.variants.size > 1 %}true{% else %}false{% endif %}"
                  >
                    {% if stl_product.variants.size > 1 %}
                      <div class="shop-the-look__option-slot shop-the-look__option-slot--hidden">
                        <label class="shop-the-look__label" for="{{ stl_variant_select_id }}">Choose option</label>
                        <select class="shop-the-look__select" id="{{ stl_variant_select_id }}" data-stl-variant-select>
                          {% for variant in stl_product.variants %}
                            <option
                              value="{{ variant.id }}"
                              data-price="{{ variant.price | money }}"
                              data-compare="{{ variant.compare_at_price | money }}"
                              data-price-amount="{{ variant.price }}"
                              data-compare-amount="{{ variant.compare_at_price }}"
                              data-available="{{ variant.available }}"
                              {% if variant.id == stl_variant.id %}selected{% endif %}
                              {% unless variant.available %}disabled{% endunless %}
                            >
                              {{ variant.title }}
                            </option>
                          {% endfor %}
                        </select>
                      </div>
                    {% endif %}

                    <input type="hidden" name="id" value="{{ stl_variant.id }}" data-stl-variant-id>
                    <button
                      type="submit"
                      class="btn btn--atc shop-the-look__add"
                      data-stl-add-button
                      {% if stl_product.variants.size > 1 %}
                        {% unless stl_product.available %}disabled{% endunless %}
                      {% else %}
                        {% unless stl_variant.available %}disabled{% endunless %}
                      {% endif %}
                    >
                      <span
                        class="btn-icon"
                        aria-hidden="true"
                        {% if stl_product.variants.size > 1 %}
                          hidden
                        {% else %}
                          {% unless stl_variant.available %}hidden{% endunless %}
                        {% endif %}
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                        </svg>
                      </span>
                      <span class="btn-text" data-stl-add-text>
                        {% if stl_product.variants.size > 1 %}
                          {% if stl_product.available %}Choose options{% else %}Sold out{% endif %}
                        {% else %}
                          {% if stl_variant.available %}Add to cart{% else %}Sold out{% endif %}
                        {% endif %}
                      </span>
                    </button>
                  </form>
                </div>
              </article>
              {% assign stl_card_index = stl_card_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{% endif %}

<div class="product-lightbox" data-lightbox aria-hidden="true">
  <button class="product-lightbox__close" type="button" data-lightbox-close aria-label="Close image">✕</button>
  <button class="product-lightbox__nav product-lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous image">‹</button>
  <img class="product-lightbox__image" data-lightbox-image alt="">
  <button class="product-lightbox__nav product-lightbox__nav--next" type="button" data-lightbox-next aria-label="Next image">›</button>
</div>

<script>
  (() => {
    const variants = {{ product.variants | json }};
    const galleryImages = [...document.querySelectorAll("[data-gallery-image]")];
    const gallerySources = galleryImages.map((item) => {
      const img = item.querySelector("img");
      return {
        zoom: item.dataset.zoom || img?.src || "",
        alt: item.dataset.alt || img?.alt || "",
      };
    });

    const lightbox = document.querySelector("[data-lightbox]");
    const lightboxImg = lightbox?.querySelector("[data-lightbox-image]");
    const lightboxClose = lightbox?.querySelector("[data-lightbox-close]");
    const lightboxPrev = lightbox?.querySelector("[data-lightbox-prev]");
    const lightboxNext = lightbox?.querySelector("[data-lightbox-next]");
    if (lightbox && lightboxImg && gallerySources.length > 0) {
      let currentIndex = 0;

      const showAt = (idx) => {
        currentIndex = (idx + gallerySources.length) % gallerySources.length;
        const next = gallerySources[currentIndex];
        lightboxImg.src = next.zoom;
        lightboxImg.alt = next.alt;
      };

      const openLightbox = (index) => {
        showAt(index);
        lightbox.classList.add("is-open");
        lightbox.setAttribute("aria-hidden", "false");
      };
      const closeLightbox = () => {
        lightbox.classList.remove("is-open");
        lightbox.setAttribute("aria-hidden", "true");
      };

      galleryImages.forEach((item, index) => {
        item.addEventListener("click", () => openLightbox(index));
      });

      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      lightboxClose.addEventListener("click", closeLightbox);
      lightboxPrev?.addEventListener("click", (e) => {
        e.stopPropagation();
        showAt(currentIndex - 1);
      });
      lightboxNext?.addEventListener("click", (e) => {
        e.stopPropagation();
        showAt(currentIndex + 1);
      });
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeLightbox();
        if (lightbox.classList.contains("is-open")) {
          if (e.key === "ArrowLeft") showAt(currentIndex - 1);
          if (e.key === "ArrowRight") showAt(currentIndex + 1);
        }
      });
    }

    const variantSelect = document.getElementById("variantSelect");
    const productForm = document.querySelector(".product-form");
    const priceWrap = document.querySelector("[data-product-price]");
    const priceValue = priceWrap?.querySelector(".product-price-value");
    const compareValue = priceWrap?.querySelector(".product-compare");
    const addBtn = document.querySelector("[data-add-to-cart]");
    const addBtnText = addBtn?.querySelector(".btn-text");
    const addBtnIcon = addBtn?.querySelector(".btn-icon");
    const qtyWrapper = document.querySelector("[data-qty-wrapper]");
    const formRow = document.querySelector(".product-form-row");
    const optionGroups = document.querySelectorAll("[data-option-index]");
    const floatingBar = document.querySelector("[data-floating-atc]");
    const floatingPrice = floatingBar?.querySelector("[data-floating-price]");
    const floatingAddBtn = floatingBar?.querySelector("[data-floating-add-to-cart]");
    const floatingAddText = floatingBar?.querySelector("[data-floating-add-text]");
    const floatingAddIcon = floatingBar?.querySelector("[data-floating-add-icon]");

    const syncFloatingState = (available, price) => {
      if (floatingPrice && price) {
        floatingPrice.textContent = price;
      }
      if (floatingAddBtn) {
        floatingAddBtn.disabled = !available;
        if (floatingAddText) {
          floatingAddText.textContent = available ? "Add to cart" : "Sold out";
        } else {
          floatingAddBtn.textContent = available ? "Add to cart" : "Sold out";
        }
      }
      if (floatingAddIcon) {
        floatingAddIcon.hidden = !available;
      }
    };

    const setFloatingVisibility = (visible) => {
      if (!floatingBar) return;
      floatingBar.classList.toggle("is-visible", visible);
      floatingBar.setAttribute("aria-hidden", visible ? "false" : "true");
    };

    if (floatingAddBtn && addBtn && productForm) {
      floatingAddBtn.addEventListener("click", () => {
        if (addBtn.disabled) return;
        if (typeof productForm.requestSubmit === "function") {
          productForm.requestSubmit(addBtn);
        } else {
          addBtn.click();
        }
      });
    }

    if (floatingBar) {
      floatingBar.addEventListener("click", (e) => {
        if (e.target.closest("[data-floating-add-to-cart]")) return;
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    if (floatingBar && addBtn) {
      const checkVisibility = () => {
        const rect = addBtn.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const inView = rect.top < viewportHeight && rect.bottom > 0;
        setFloatingVisibility(!inView && !addBtn.disabled);
      };

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            setFloatingVisibility(!entry.isIntersecting && !addBtn.disabled);
          },
          { threshold: 0.4 }
        );
        observer.observe(addBtn);
        window.addEventListener("resize", checkVisibility);
      } else {
        window.addEventListener("scroll", checkVisibility, { passive: true });
        window.addEventListener("resize", checkVisibility);
      }
      checkVisibility();
    }

    if (variantSelect) {
      function updateFromOption(option){
        if (!option) return;
        const optionPrice = option.dataset.price || "";
        if (priceValue) priceValue.textContent = optionPrice;

        if (compareValue) {
          const priceAmount = Number(option.dataset.priceAmount || 0);
          const compareAmount = Number(option.dataset.compareAmount || 0);
          if (compareAmount > priceAmount) {
            compareValue.textContent = option.dataset.compare || "";
            compareValue.hidden = false;
          } else {
            compareValue.hidden = true;
          }
        }

        if (addBtn) {
          const available = option.dataset.available === "true";
          addBtn.disabled = !available;
          if (qtyWrapper) qtyWrapper.hidden = !available;
          if (addBtnIcon) addBtnIcon.hidden = !available;
          if (formRow) formRow.classList.toggle("is-sold-out", !available);
          if (addBtnText) {
            addBtnText.textContent = available ? "Add to cart" : "Sold out";
          } else {
            addBtn.textContent = available ? "Add to cart" : "Sold out";
          }
          syncFloatingState(available, optionPrice);
        }
      }

      updateFromOption(variantSelect.selectedOptions?.[0]);
      variantSelect.addEventListener("change", (e) => {
        updateFromOption(e.target.selectedOptions?.[0]);
      });

      if (optionGroups.length && variants.length) {
        const findVariant = (selected) =>
          variants.find((v) => v.options.every((opt, idx) => opt === selected[idx]));

        let selectedOptions =
          variants.find((v) => v.id === Number(variantSelect.value))?.options || [];

        const syncButtons = () => {
          optionGroups.forEach((group) => {
            const index = Number(group.dataset.optionIndex);
            group.querySelectorAll("[data-option-value]").forEach((btn) => {
              const active = btn.dataset.optionValue === selectedOptions[index];
              btn.classList.toggle("is-active", active);
              btn.setAttribute("aria-pressed", active ? "true" : "false");
            });
          });
        };

        syncButtons();

        optionGroups.forEach((group) => {
          const index = Number(group.dataset.optionIndex);
          group.querySelectorAll("[data-option-value]").forEach((btn) => {
            btn.addEventListener("click", () => {
              selectedOptions[index] = btn.dataset.optionValue;
              const match = findVariant(selectedOptions);
              if (match) {
                variantSelect.value = match.id;
                variantSelect.dispatchEvent(new Event("change", { bubbles: true }));
              }
              syncButtons();
            });
          });
        });

        variantSelect.addEventListener("change", () => {
          selectedOptions =
            variants.find((v) => v.id === Number(variantSelect.value))?.options || selectedOptions;
          syncButtons();
        });
      }
    } else {
      syncFloatingState(!addBtn?.disabled, priceValue?.textContent?.trim());
    }

    // Accordion Logic
    const accordions = document.querySelectorAll(".accordion-header");
    accordions.forEach(header => {
        header.addEventListener("click", () => {
            const content = header.nextElementSibling;
            const isOpen = content.classList.contains("is-open");
            
            // Close others if desired (optional, keeping independent here)
            // accordions.forEach(h => {
            //    if(h !== header) {
            //        h.nextElementSibling.classList.remove("is-open");
            //        h.querySelector(".accordion-icon").textContent = "+";
            //    }
            // });

            content.classList.toggle("is-open");
            header.setAttribute("aria-expanded", !isOpen);
            header.querySelector(".accordion-icon").textContent = isOpen ? "+" : "-";
        });
    });

    // Description Section Parser
    // Branvas exports product.description as structured HTML with <h3><strong>SectionName</strong></h3> headers.
    // We parse those headers and distribute content into the correct accordion panels.
    (() => {
      const rawEl = document.getElementById('product-description-raw');
      if (!rawEl) return;

      const descAccordion = document.getElementById('accordion-description');
      const detailsAccordion = document.getElementById('accordion-details');
      const materialsAccordion = document.getElementById('accordion-materials');
      const detailsItem = document.getElementById('accordion-item-details');
      const materialsItem = document.getElementById('accordion-item-materials');

      // Parse the raw HTML into a temporary container
      const temp = document.createElement('div');
      temp.innerHTML = rawEl.innerHTML;

      const sections = { description: [], details: [], materials: [] };
      let currentSection = 'description';

      // Walk through child nodes and bucket them by section
      temp.childNodes.forEach(node => {
        // Detect section header: <h3><strong>SectionName</strong></h3>
        if (node.nodeType === Node.ELEMENT_NODE && node.tagName === 'H3') {
          const headerText = node.textContent.trim().toLowerCase();
          if (headerText === 'description') {
            currentSection = 'description';
            return; // skip the header itself
          } else if (headerText === 'details') {
            currentSection = 'details';
            return;
          } else if (headerText === 'materials') {
            currentSection = 'materials';
            return;
          }
        }
        sections[currentSection].push(node.cloneNode(true));
      });

      // Helper: inject nodes into a target element
      const inject = (target, nodes) => {
        if (!target) return;
        // Clear any Liquid-rendered placeholder content
        target.innerHTML = '';
        nodes.forEach(n => target.appendChild(n));
      };

      if (sections.description.length && descAccordion) {
        inject(descAccordion, sections.description);
      }

      if (sections.details.length && detailsAccordion) {
        inject(detailsAccordion, sections.details);
        if (detailsItem) detailsItem.style.display = '';
      } else if (detailsItem) {
        // Hide the Details accordion if no content
        detailsItem.style.display = 'none';
      }

      if (sections.materials.length && materialsAccordion) {
        inject(materialsAccordion, sections.materials);
        if (materialsItem) materialsItem.style.display = '';
      } else if (materialsItem) {
        // Hide the Materials accordion if no content
        materialsItem.style.display = 'none';
      }
    })();

    // Quantity Logic
    const qtyInput = document.getElementById("quantity");
    const minusBtn = document.querySelector("[data-qty-minus]");
    const plusBtn = document.querySelector("[data-qty-plus]");

    if(qtyInput && minusBtn && plusBtn) {
        const minQty = Number(qtyInput.min) || 1;
        const maxQty = Number(qtyInput.max) || 99;
        const clampQty = (value) => {
            const parsed = parseInt(value, 10);
            if (!Number.isFinite(parsed)) return minQty;
            return Math.min(maxQty, Math.max(minQty, parsed));
        };
        const syncQty = (value) => {
            const nextQty = clampQty(value);
            qtyInput.value = nextQty;
            minusBtn.disabled = nextQty <= minQty;
            plusBtn.disabled = nextQty >= maxQty;
        };

        minusBtn.addEventListener("click", () => {
            syncQty((parseInt(qtyInput.value, 10) || minQty) - 1);
        });
        plusBtn.addEventListener("click", () => {
            syncQty((parseInt(qtyInput.value, 10) || minQty) + 1);
        });
        qtyInput.addEventListener("input", () => {
            syncQty(qtyInput.value);
        });
        syncQty(qtyInput.value);
    }

  })();
</script>
