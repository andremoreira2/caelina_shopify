<section class="cart-page">
  <div class="cart-page__header">
    <h1 class="cart-title page-title">Your cart</h1>
    <a class="cart-page__continue" href="/collections/all">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      Continue shopping
    </a>
  </div>

  {% if cart.item_count == 0 %}
    <div class="cart-empty">
      <div class="cart-empty__icon">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
      </div>
      <p class="cart-empty__text">Your cart is empty</p>
      <p class="cart-empty__subtext">Looks like you haven't added anything yet.</p>
      <a class="cart-empty__cta" href="/collections/all">Explore the collection</a>
    </div>
  {% else %}
    {% form 'cart', cart, class: 'cart-form' %}
      <!-- Free Shipping Progress Bar -->
      {% assign shipping_threshold = 10000 %}
      {% assign remaining_cents = shipping_threshold | minus: cart.total_price %}
      {% if remaining_cents < 0 %}{% assign remaining_cents = 0 %}{% endif %}
      {% assign progress = cart.total_price | times: 100 | divided_by: shipping_threshold %}
      {% if progress > 100 %}{% assign progress = 100 %}{% endif %}

      <div class="cart-shipping-bar">
        {% if remaining_cents > 0 %}
          <p class="cart-shipping-bar__text">
            You are <strong>{{ remaining_cents | money }}</strong> away from free shipping
          </p>
        {% else %}
          <p class="cart-shipping-bar__text cart-shipping-bar__text--success">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            You've unlocked <strong>free shipping!</strong>
          </p>
        {% endif %}
        <div class="cart-shipping-bar__track">
          <div class="cart-shipping-bar__fill" style="width: {{ progress }}%"></div>
        </div>
      </div>

      <div class="cart-grid">
        <div class="cart-lines">
          {% for item in cart.items %}
            <div class="cart-line" data-cart-line data-key="{{ item.key }}">
              <a class="cart-line-media" href="{{ item.url }}">
                {% if item.image %}
                  <img
                    src="{{ item.image | image_url: width: 240 }}"
                    alt="{{ item.image.alt | escape }}"
                    loading="lazy"
                  >
                {% else %}
                  <div class="cart-line-placeholder">No image</div>
                {% endif %}
              </a>
              <div class="cart-line-info">
                <div class="cart-line-info__top">
                  <div class="cart-line-meta">
                    <a class="cart-line-title" href="{{ item.url }}">{{ item.product.title }}</a>
                    {% if item.variant.title != "Default Title" %}
                      <div class="cart-line-variant">{{ item.variant.title }}</div>
                    {% endif %}
                  </div>
                  <button class="cart-line-remove" type="button" title="Remove item" onclick="window.location.href='{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0'">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      <line x1="10" y1="11" x2="10" y2="17"></line>
                      <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                  </button>
                </div>
                <div class="cart-line-info__bottom">
                  <div class="cart-line-qty-wrapper">
                    <button class="cart-line-qty__btn" type="button" aria-label="Decrease quantity" onclick="var i=this.parentElement.querySelector('input');i.value=Math.max(0,parseInt(i.value)-1);i.dispatchEvent(new Event('change'))">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </button>
                    <input
                      id="updates_{{ item.key }}"
                      class="cart-line-qty"
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      aria-label="Quantity"
                    >
                    <button class="cart-line-qty__btn" type="button" aria-label="Increase quantity" onclick="var i=this.parentElement.querySelector('input');i.value=parseInt(i.value)+1;i.dispatchEvent(new Event('change'))">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </button>
                  </div>
                  {% render 'price',
                    amount: item.final_line_price,
                    wrapper_class: 'cart-line-price price--compact'
                  %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <aside class="cart-summary">
          <h2 class="cart-summary__title">Order summary</h2>

          <div class="cart-summary-row">
            <span>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
            {% render 'price',
              amount: cart.total_price,
              wrapper_tag: 'span',
              wrapper_class: 'price--compact'
            %}
          </div>

          <div class="cart-summary-row cart-summary-row--shipping">
            <span>Shipping</span>
            <span class="cart-summary__shipping-value">
              {% if remaining_cents <= 0 %}
                <span class="cart-summary__free">FREE</span>
              {% else %}
                Calculated at checkout
              {% endif %}
            </span>
          </div>

          {% if cart.cart_level_discount_applications.size > 0 %}
            <div class="cart-summary-discounts">
              {% for discount in cart.cart_level_discount_applications %}
                <div class="cart-summary-row cart-summary-row--discount">
                  <span>{{ discount.title }}</span>
                  {% render 'price',
                    amount: discount.total_allocated_amount,
                    wrapper_tag: 'span',
                    wrapper_class: 'price--compact',
                    current_prefix: '-'
                  %}
                </div>
              {% endfor %}
            </div>
          {% endif %}

          <div class="cart-summary__divider"></div>

          <div class="cart-summary-row cart-summary-row--total">
            <span>Total</span>
            {% render 'price',
              amount: cart.total_price,
              wrapper_tag: 'span',
              wrapper_class: 'price--compact cart-summary__total-price'
            %}
          </div>

          <div class="cart-actions">
            <button class="btn btn--checkout" type="submit" name="checkout">
              <span class="btn--checkout__content">
                <span class="btn--checkout__label">Checkout securely</span>
                <span class="btn--checkout__icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false">
                    <path fill="currentColor" d="M8 1.75A2.75 2.75 0 0 0 5.25 4.5V7H4a1 1 0 0 0-1 1v5.25a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-1.25V4.5A2.75 2.75 0 0 0 8 1.75Zm1.25 5.25h-2.5V4.5a1.25 1.25 0 1 1 2.5 0V7Zm-1.9 2.25h1.3c.11 0 .2.09.2.2v.72c0 .07.04.14.09.18.3.22.49.57.49.97A1.43 1.43 0 0 1 8 12.75a1.43 1.43 0 0 1-1.43-1.43c0-.4.19-.75.49-.97a.22.22 0 0 0 .09-.18v-.72c0-.11.09-.2.2-.2Z"/>
                  </svg>
                </span>
              </span>
            </button>
            <button class="cart-actions__update" type="submit" name="update">Update cart</button>
          </div>

          <div class="cart-trust">
            <div class="cart-trust__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Secure checkout</span>
            </div>
            <div class="cart-trust__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="1 4 1 10 7 10"></polyline>
                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
              </svg>
              <span>Free returns</span>
            </div>
            <div class="cart-trust__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span>Fast shipping</span>
            </div>
          </div>
          <p class="cart-note">Shipping and taxes calculated at checkout.</p>
        </aside>
      </div>
    {% endform %}
  {% endif %}
</section>
