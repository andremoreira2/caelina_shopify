<style>
  @font-face {
    font-family: "Mayonice";
    src:
      url("{{ 'Mayonice.woff2' | asset_url }}") format("woff2"),
      url("{{ 'Mayonice.ttf' | asset_url }}") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
</style>

<section class="home-page home-page--minimal">
  <div class="home-page__media">
    <video class="home-page__video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
      <source src="https://cdn.shopify.com/videos/c/o/v/cd7e30225724449c9a6523df4f7331e2.mp4" type="video/mp4">
    </video>
    <div class="home-page__media-intro" aria-hidden="true"></div>
    <a class="home-page__explore-button" href="{{ routes.root_url }}">EXPLORE</a>
  </div>
  <section class="home-collections" aria-label="Jewelry collections" data-home-collections>
    <div class="home-collections__top">
      <h2 class="home-collections__heading">SHOP BY COLLECTION</h2>
      <div class="home-collections__line" aria-hidden="true"></div>
    </div>

    <div class="home-collections__frame">
      <div class="home-collections__controls">
        <button class="home-collections__control" type="button" aria-label="Previous collections" data-home-collections-prev>
          <span aria-hidden="true">‹</span>
        </button>
        <button class="home-collections__control" type="button" aria-label="Next collections" data-home-collections-next>
          <span aria-hidden="true">›</span>
        </button>
      </div>
      <div class="home-collections__viewport" data-home-collections-viewport tabindex="0" aria-label="Jewelry categories slider">
        <div class="home-collections__track">
          {% assign jewelry_entries = 'earrings:EARRINGS|rings:RINGS|necklaces:NECKLACE|bracelets:BRACELETS|watches:WATCHES' | split: '|' %}
          {% for entry in jewelry_entries %}
            {% assign parts = entry | split: ':' %}
            {% assign handle = parts[0] %}
            {% assign card_title = parts[1] %}
            {% assign jewelry_collection = collections[handle] %}
            {% assign card_url = '/collections/' | append: handle %}
            {% assign card_image = blank %}

            {% if jewelry_collection %}
              {% assign card_url = jewelry_collection.url %}
              {% assign card_image = jewelry_collection.featured_image %}
              {% if card_image == blank and jewelry_collection.products.first %}
                {% assign card_image = jewelry_collection.products.first.featured_image %}
              {% endif %}
            {% endif %}

            <a class="home-collections__card" href="{{ card_url }}">
              {% if card_image != blank %}
                <img
                  class="home-collections__image"
                  src="{{ card_image | image_url: width: 1600 }}"
                  alt="{{ card_title }}"
                  loading="lazy"
                  width="800"
                  height="1120"
                >
              {% else %}
                <span class="home-collections__image home-collections__image--fallback" aria-hidden="true"></span>
              {% endif %}
              <span class="home-collections__shade" aria-hidden="true"></span>
              <span class="home-collections__content">
                <span class="home-collections__title">{{ card_title }}</span>
                <span class="home-collections__cta">EXPLORE</span>
              </span>
            </a>
          {% endfor %}
        </div>
      </div>
      <div class="home-collections__pagination" data-home-collections-pagination aria-label="Carousel progress"></div>
    </div>
  </section>

  {% assign home_stl_title = 'Shop The Look' %}
  {% assign home_stl_image = blank %}
  {% assign home_stl_products = blank %}
  {% assign home_stl_hotspots = blank %}
  {% assign home_stl_set = shop.metafields.custom.home_shop_the_look_set.value %}
  {% if home_stl_set == blank %}
    {% assign home_stl_set = shop.metafields.custom.shop_the_look_set.value %}
  {% endif %}

  {% if home_stl_set != blank %}
    {% assign home_stl_set_title = home_stl_set.shop_the_look_title.value | default: home_stl_set.title.value | default: home_stl_set.shop_the_look_title | default: home_stl_set.title %}
    {% assign home_stl_set_image = home_stl_set.shop_the_look_image.value | default: home_stl_set.image.value | default: home_stl_set.shop_the_look_image | default: home_stl_set.image %}
    {% assign home_stl_set_products = home_stl_set.shop_the_look_products.value | default: home_stl_set.products.value | default: home_stl_set.shop_the_look_products | default: home_stl_set.products %}
    {% assign home_stl_set_hotspots = home_stl_set.shop_the_look_hotspots.value | default: home_stl_set.hotspots.value | default: home_stl_set.shop_the_look_hotspots | default: home_stl_set.hotspots %}

    {% if home_stl_set_title != blank %}
      {% assign home_stl_title = home_stl_set_title %}
    {% endif %}
    {% if home_stl_set_image != blank %}
      {% assign home_stl_image = home_stl_set_image %}
    {% endif %}
    {% if home_stl_set_products != blank %}
      {% assign home_stl_products = home_stl_set_products %}
    {% endif %}
    {% if home_stl_set_hotspots != blank %}
      {% assign home_stl_hotspots = home_stl_set_hotspots %}
    {% endif %}
  {% endif %}

  {% assign home_stl_product_count = 0 %}
  {% if home_stl_products != blank %}
    {% for home_stl_product in home_stl_products limit: 4 %}
      {% if home_stl_product != blank %}
        {% assign home_stl_product_count = home_stl_product_count | plus: 1 %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if home_stl_image != blank and home_stl_product_count > 0 %}
    <section class="shop-the-look shop-the-look--home" data-shop-the-look>
      <div class="shop-the-look__inner">
        <div class="shop-the-look__layout">
          <div class="shop-the-look__media-column">
            <div class="shop-the-look__header">
              <h2 class="shop-the-look__title">{{ home_stl_title }}</h2>
            </div>
            <div class="shop-the-look__media-wrap" style="--stl-image-ratio: {{ home_stl_image.aspect_ratio | default: 0.8571428571 }};">
              <img
                class="shop-the-look__image"
                src="{{ home_stl_image | image_url: width: 1800 }}"
                alt="{{ home_stl_title | escape }}"
                loading="lazy"
                width="{{ home_stl_image.width | default: 1200 }}"
                height="{{ home_stl_image.height | default: 1400 }}"
              >
              <div class="shop-the-look__dots">
                {% assign home_stl_dot_index = 0 %}
                {% for home_stl_product in home_stl_products limit: 4 %}
                  {% if home_stl_product != blank %}
                    {% assign fallback_x = 50 %}
                    {% assign fallback_y = 50 %}
                    {% case home_stl_dot_index %}
                      {% when 0 %}
                        {% assign fallback_x = 28 %}
                        {% assign fallback_y = 34 %}
                      {% when 1 %}
                        {% assign fallback_x = 64 %}
                        {% assign fallback_y = 30 %}
                      {% when 2 %}
                        {% assign fallback_x = 70 %}
                        {% assign fallback_y = 62 %}
                      {% when 3 %}
                        {% assign fallback_x = 48 %}
                        {% assign fallback_y = 78 %}
                    {% endcase %}

                    {% assign home_stl_dot_x = fallback_x %}
                    {% assign home_stl_dot_y = fallback_y %}
                    {% assign home_stl_dot_label = home_stl_product.title %}
                    {% if home_stl_hotspots != blank and home_stl_hotspots.size > home_stl_dot_index %}
                      {% assign home_stl_hotspot = home_stl_hotspots[home_stl_dot_index] %}
                      {% if home_stl_hotspot.x != blank %}
                        {% assign home_stl_dot_x = home_stl_hotspot.x %}
                      {% endif %}
                      {% if home_stl_hotspot.y != blank %}
                        {% assign home_stl_dot_y = home_stl_hotspot.y %}
                      {% endif %}
                      {% if home_stl_hotspot.label != blank %}
                        {% assign home_stl_dot_label = home_stl_hotspot.label %}
                      {% endif %}
                    {% endif %}
                    <button
                      class="shop-the-look__dot{% if home_stl_dot_index == 0 %} is-active{% endif %}"
                      type="button"
                      data-stl-dot
                      data-index="{{ home_stl_dot_index }}"
                      aria-label="Show {{ home_stl_dot_label | escape }}"
                      aria-pressed="{% if home_stl_dot_index == 0 %}true{% else %}false{% endif %}"
                      style="left: {{ home_stl_dot_x | at_least: 0 | at_most: 100 }}%; top: {{ home_stl_dot_y | at_least: 0 | at_most: 100 }}%;"
                    >
                      <span class="shop-the-look__dot-core" aria-hidden="true"></span>
                    </button>
                    {% assign home_stl_dot_index = home_stl_dot_index | plus: 1 %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="shop-the-look__panel">
            {% assign home_stl_card_index = 0 %}
            {% for home_stl_product in home_stl_products limit: 4 %}
              {% if home_stl_product != blank %}
                {% assign home_stl_active = false %}
                {% if home_stl_card_index == 0 %}
                  {% assign home_stl_active = true %}
                {% endif %}
                {% assign home_stl_variant = home_stl_product.selected_or_first_available_variant | default: home_stl_product.variants.first %}
                {% assign home_stl_product_image = home_stl_product.featured_image | default: home_stl_product.images.first %}
                {% capture home_stl_variant_select_id %}homeStlVariant-{{ home_stl_card_index }}{% endcapture %}
                <article
                  class="shop-the-look__card{% if home_stl_active %} is-active{% endif %}"
                  data-stl-card
                  data-index="{{ home_stl_card_index }}"
                >
                  <a class="shop-the-look__card-media" href="{{ home_stl_product.url }}">
                    {% if home_stl_product_image != blank %}
                      <img
                        src="{{ home_stl_product_image | image_url: width: 1000 }}"
                        alt="{{ home_stl_product_image.alt | default: home_stl_product.title | escape }}"
                        loading="lazy"
                        width="{{ home_stl_product_image.width | default: 900 }}"
                        height="{{ home_stl_product_image.height | default: 900 }}"
                      >
                    {% else %}
                      <span class="shop-the-look__media-fallback" aria-hidden="true"></span>
                    {% endif %}
                  </a>

                  <div class="shop-the-look__card-meta">
                    <h3 class="shop-the-look__product-title"><a href="{{ home_stl_product.url }}">{{ home_stl_product.title }}</a></h3>
                    <div class="shop-the-look__price-line">
                      <span class="shop-the-look__price-value" data-stl-price>{{ home_stl_variant.price | money }}</span>
                      <span
                        class="shop-the-look__price-compare"
                        data-stl-compare
                        {% if home_stl_variant.compare_at_price <= home_stl_variant.price %}hidden{% endif %}
                      >
                        {{ home_stl_variant.compare_at_price | money }}
                      </span>
                    </div>

                    <form
                      method="post"
                      action="/cart/add"
                      class="shop-the-look__form"
                      data-stl-product-title="{{ home_stl_product.title | escape }}"
                      data-stl-requires-choice="{% if home_stl_product.variants.size > 1 %}true{% else %}false{% endif %}"
                    >
                      {% if home_stl_product.variants.size > 1 %}
                        <div class="shop-the-look__option-slot shop-the-look__option-slot--hidden">
                          <label class="shop-the-look__label" for="{{ home_stl_variant_select_id }}">Choose option</label>
                          <select class="shop-the-look__select" id="{{ home_stl_variant_select_id }}" data-stl-variant-select>
                            {% for variant in home_stl_product.variants %}
                              <option
                                value="{{ variant.id }}"
                                data-price="{{ variant.price | money }}"
                                data-compare="{{ variant.compare_at_price | money }}"
                                data-price-amount="{{ variant.price }}"
                                data-compare-amount="{{ variant.compare_at_price }}"
                                data-available="{{ variant.available }}"
                                {% if variant.id == home_stl_variant.id %}selected{% endif %}
                                {% unless variant.available %}disabled{% endunless %}
                              >
                                {{ variant.title }}
                              </option>
                            {% endfor %}
                          </select>
                        </div>
                      {% endif %}

                      <input type="hidden" name="id" value="{{ home_stl_variant.id }}" data-stl-variant-id>
                      <button
                        type="submit"
                        class="btn shop-the-look__add"
                        data-stl-add-button
                        {% if home_stl_product.variants.size > 1 %}
                          {% unless home_stl_product.available %}disabled{% endunless %}
                        {% else %}
                          {% unless home_stl_variant.available %}disabled{% endunless %}
                        {% endif %}
                      >
                        <span
                          class="btn-icon"
                          aria-hidden="true"
                          {% if home_stl_product.variants.size > 1 %}
                            hidden
                          {% else %}
                            {% unless home_stl_variant.available %}hidden{% endunless %}
                          {% endif %}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                          </svg>
                        </span>
                        <span class="btn-text" data-stl-add-text>
                          {% if home_stl_product.variants.size > 1 %}
                            {% if home_stl_product.available %}Choose options{% else %}Sold out{% endif %}
                          {% else %}
                            {% if home_stl_variant.available %}Add to cart{% else %}Sold out{% endif %}
                          {% endif %}
                        </span>
                      </button>
                    </form>
                  </div>
                </article>
                {% assign home_stl_card_index = home_stl_card_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  <section class="home-story" data-home-story>
    <div class="home-story__sticky">
      <div class="home-story__pronunciation">
        <span class="home-story__ipa">/keɪˈliːnə/</span>
        <span class="home-story__phonetic">[kay·LEE·nah]</span>
      </div>
      <div class="home-story__name" data-home-story-name>Caelina</div>
      <p class="home-story__text" data-home-story-text>
        A name from Latin CAELUM &mdash; sky; heaven, evoking grace, divine elegance, and celestial beauty.
      </p>
    </div>
  </section>
</section>

<script>
  (function initHomeCollectionsCarousel() {
    var sections = document.querySelectorAll("[data-home-collections]");
    if (!sections.length) return;
    var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    var autoplayDelay = 2300;

    sections.forEach(function (section) {
      var viewport = section.querySelector("[data-home-collections-viewport]");
      var prev = section.querySelector("[data-home-collections-prev]");
      var next = section.querySelector("[data-home-collections-next]");
      var track = section.querySelector(".home-collections__track");
      var pagination = section.querySelector("[data-home-collections-pagination]");
      if (!viewport || !prev || !next || !track || !pagination) return;
      var pageCount = 1;
      var currentIndex = 0;
      var scrollPoints = [0];
      var dots = [];
      var rafId = null;
      var lastFrameAt = 0;
      var elapsedInCycle = 0;
      var suppressScrollResetUntil = 0;
      var lastUserGestureAt = 0;
      var hasResetForGesture = false;

      function getMaxScroll() {
        return Math.max(0, viewport.scrollWidth - viewport.clientWidth);
      }

      function rebuildScrollPoints() {
        var cards = track.querySelectorAll(".home-collections__card");
        var maxScroll = getMaxScroll();
        var nextPoints = [0];
        var viewportRect = viewport.getBoundingClientRect();
        var currentScroll = viewport.scrollLeft;

        cards.forEach(function (card) {
          var cardRect = card.getBoundingClientRect();
          var left = currentScroll + (cardRect.left - viewportRect.left);
          left = Math.min(maxScroll, Math.max(0, left));
          if (Math.abs(left - nextPoints[nextPoints.length - 1]) > 2) {
            nextPoints.push(left);
          }
        });

        if (Math.abs(maxScroll - nextPoints[nextPoints.length - 1]) > 1) {
          nextPoints.push(maxScroll);
        }

        scrollPoints = nextPoints;
        pageCount = Math.max(1, scrollPoints.length);
      }

      function getCurrentIndex() {
        var left = viewport.scrollLeft;
        var closestIndex = 0;
        var closestDistance = Infinity;

        scrollPoints.forEach(function (point, index) {
          var distance = Math.abs(point - left);
          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        return closestIndex;
      }

      function setProgress(progress) {
        var clamped = Math.max(0, Math.min(1, progress));
        dots.forEach(function (dot, index) {
          dot.style.setProperty("--progress", index === currentIndex ? clamped : 0);
        });
      }

      function updateActiveDot() {
        dots.forEach(function (dot, index) {
          var isActive = index === currentIndex;
          dot.classList.toggle("is-active", isActive);
          dot.setAttribute("aria-current", isActive ? "true" : "false");
        });
      }

      function buildDots() {
        pagination.innerHTML = "";
        dots = [];

        for (var i = 0; i < pageCount; i += 1) {
          var dot = document.createElement("button");
          dot.type = "button";
          dot.className = "home-collections__dot";
          dot.setAttribute("aria-label", "Go to slide " + (i + 1));
          dot.innerHTML = '<span class="home-collections__dot-fill" aria-hidden="true"></span>';
          dot.dataset.index = i;
          dot.addEventListener("click", function () {
            var targetIndex = Number(this.dataset.index);
            runManualNavigation(function () {
              scrollToIndex(targetIndex);
            });
          });
          pagination.appendChild(dot);
          dots.push(dot);
        }

        pagination.classList.toggle("is-single", pageCount <= 1);
      }

      function updateControls() {
        currentIndex = getCurrentIndex();
        var hasMultiplePages = pageCount > 1;
        prev.disabled = !hasMultiplePages;
        next.disabled = !hasMultiplePages;
        updateActiveDot();
      }

      function scrollToIndex(index) {
        var targetIndex = Math.min(pageCount - 1, Math.max(0, index));
        var targetLeft = scrollPoints[targetIndex] || 0;
        suppressScrollResetUntil = performance.now() + 500;
        viewport.scrollTo({ left: targetLeft, behavior: "smooth" });
      }

      function scrollByStep(direction) {
        if (pageCount <= 1) return;
        var nextIndex = getCurrentIndex() + direction;
        if (nextIndex > pageCount - 1) nextIndex = 0;
        if (nextIndex < 0) nextIndex = pageCount - 1;
        scrollToIndex(nextIndex);
      }

      function canAutoplay() {
        return pageCount > 1;
      }

      function resetTimer() {
        elapsedInCycle = 0;
        lastFrameAt = performance.now();
        setProgress(0);
      }

      function stopTimer() {
        if (!rafId) return;
        cancelAnimationFrame(rafId);
        rafId = null;
      }

      function runManualNavigation(navigate) {
        stopTimer();
        navigate();
        resetTimer();
        startTimer();
      }

      function noteUserGesture() {
        lastUserGestureAt = performance.now();
        hasResetForGesture = false;
      }

      function maybeResetTimerForUserScroll() {
        var now = performance.now();
        var gestureIsRecent = now - lastUserGestureAt < 900;
        if (!gestureIsRecent || hasResetForGesture) return;
        if (now < suppressScrollResetUntil) return;
        hasResetForGesture = true;
        stopTimer();
        resetTimer();
        startTimer();
      }

      function tick(now) {
        if (!canAutoplay()) {
          stopTimer();
          resetTimer();
          return;
        }

        var delta = Math.min(120, Math.max(0, now - lastFrameAt));
        lastFrameAt = now;

        if (!document.hidden) {
          elapsedInCycle += delta;
        }

        setProgress(elapsedInCycle / autoplayDelay);

        if (elapsedInCycle >= autoplayDelay) {
          elapsedInCycle = 0;
          scrollToIndex((currentIndex + 1) % pageCount);
        }

        rafId = requestAnimationFrame(tick);
      }

      function startTimer() {
        if (rafId || !canAutoplay()) return;
        lastFrameAt = performance.now();
        rafId = requestAnimationFrame(tick);
      }

      function recalc() {
        var previousPageCount = pageCount;
        rebuildScrollPoints();
        var countChanged = pageCount !== previousPageCount;

        if (countChanged) {
          buildDots();
          resetTimer();
        }

        updateControls();

        if (canAutoplay()) {
          startTimer();
        } else {
          stopTimer();
          resetTimer();
        }
      }

      prev.addEventListener("click", function () {
        runManualNavigation(function () {
          scrollByStep(-1);
        });
      });

      next.addEventListener("click", function () {
        runManualNavigation(function () {
          scrollByStep(1);
        });
      });

      viewport.addEventListener("scroll", function () {
        updateControls();
        maybeResetTimerForUserScroll();
      }, { passive: true });
      viewport.addEventListener("touchstart", noteUserGesture, { passive: true });
      viewport.addEventListener("pointerdown", noteUserGesture);
      viewport.addEventListener("wheel", noteUserGesture, { passive: true });
      window.addEventListener("resize", recalc);
      window.addEventListener("load", recalc);
      track.querySelectorAll("img").forEach(function (img) {
        if (img.complete) return;
        img.addEventListener("load", recalc, { once: true });
      });
      viewport.addEventListener("keydown", function (event) {
        if (event.key === "ArrowLeft") {
          runManualNavigation(function () {
            scrollByStep(-1);
          });
        }
        if (event.key === "ArrowRight") {
          runManualNavigation(function () {
            scrollByStep(1);
          });
        }
      });
      document.addEventListener("visibilitychange", function () {
        if (!document.hidden) {
          lastFrameAt = performance.now();
        }
      });

      if (typeof prefersReducedMotion.addEventListener === "function") {
        prefersReducedMotion.addEventListener("change", recalc);
      } else if (typeof prefersReducedMotion.addListener === "function") {
        prefersReducedMotion.addListener(recalc);
      }

      rebuildScrollPoints();
      buildDots();
      updateControls();
      startTimer();
    });
  })();
</script>

<script>
  (function initHomeStoryReveal() {
    var sections = document.querySelectorAll("[data-home-story]");
    if (!sections.length) return;

    var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    var darkColor = [26, 26, 31];
    var lightColor = [244, 244, 248];
    var revealLead = 0.9;
    var entries = [];
    var ticking = false;

    function clamp(value, min, max) {
      return Math.max(min, Math.min(max, value));
    }

    function mixChannel(start, end, amount) {
      return Math.round(start + (end - start) * amount);
    }

    function toRgb(amount) {
      var r = mixChannel(darkColor[0], lightColor[0], amount);
      var g = mixChannel(darkColor[1], lightColor[1], amount);
      var b = mixChannel(darkColor[2], lightColor[2], amount);
      return "rgb(" + r + ", " + g + ", " + b + ")";
    }

    function buildWords(textNode) {
      var text = textNode.textContent.replace(/\s+/g, " ").trim();
      if (!text) return [];

      var words = text.split(" ");
      var fragment = document.createDocumentFragment();
      var spans = [];
      var forcedBreakAfter = {
        latin: 0,
        heaven: 0,
        grace: 0,
        elegance: 0
      };

      words.forEach(function (word, index) {
        var span = document.createElement("span");
        var normalizedWord = word.toLowerCase().replace(/[^a-z0-9]+/g, "");
        span.className = "home-story__word home-story__word--typewriter";
        if (normalizedWord === "sky" || normalizedWord === "heaven") {
          span.classList.add("home-story__word--typewriter-italic");
        }
        span.textContent = word;
        fragment.appendChild(span);
        if (index < words.length - 1) {
          if (Object.prototype.hasOwnProperty.call(forcedBreakAfter, normalizedWord) && forcedBreakAfter[normalizedWord] === 0) {
            forcedBreakAfter[normalizedWord] = 1;
            fragment.appendChild(document.createElement("br"));
          } else {
            fragment.appendChild(document.createTextNode(" "));
          }
        }
        spans.push(span);
      });

      textNode.textContent = "";
      textNode.appendChild(fragment);
      return spans;
    }

    function buildEntries() {
      entries = [];
      sections.forEach(function (section) {
        var textNode = section.querySelector("[data-home-story-text]");
        var pronunciationNodes = section.querySelectorAll(".home-story__pronunciation span");
        var nameNode = section.querySelector("[data-home-story-name]");
        if (!textNode) return;

        entries.push({
          section: section,
          words: buildWords(textNode),
          pronunciationNodes: pronunciationNodes,
          nameNode: nameNode,
          lastProgress: -1
        });
      });
    }

    function getProgress(section) {
      var rect = section.getBoundingClientRect();
      var travel = Math.max(1, rect.height - window.innerHeight);
      return clamp((-rect.top) / travel, 0, 1);
    }

    function renderEntry(entry, progress) {
      var revealProgress = clamp(Math.pow(progress, 0.8), 0, 1);
      var revealPosition = revealProgress * (entry.words.length + revealLead);
      var pronunciationAmount = clamp(revealProgress * 1.15, 0, 1);
      var nameAmount = clamp((revealProgress - 0.02) * 20, 0, 1);

      entry.words.forEach(function (word, index) {
        var amount = clamp(revealPosition - index, 0, 1);
        word.style.color = toRgb(amount);
      });

      if (entry.pronunciationNodes && entry.pronunciationNodes.length) {
        entry.pronunciationNodes.forEach(function (node) {
          node.style.color = toRgb(pronunciationAmount);
        });
      }

      if (entry.nameNode) {
        entry.nameNode.style.color = toRgb(nameAmount);
      }
    }

    function update() {
      ticking = false;

      entries.forEach(function (entry) {
        var progress = prefersReducedMotion.matches ? 1 : getProgress(entry.section);
        if (Math.abs(progress - entry.lastProgress) < 0.001) return;
        entry.lastProgress = progress;
        renderEntry(entry, progress);
      });
    }

    function requestUpdate() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }

    buildEntries();
    requestUpdate();

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    window.addEventListener("load", requestUpdate);
    document.addEventListener("visibilitychange", requestUpdate);

    if (typeof prefersReducedMotion.addEventListener === "function") {
      prefersReducedMotion.addEventListener("change", requestUpdate);
    } else if (typeof prefersReducedMotion.addListener === "function") {
      prefersReducedMotion.addListener(requestUpdate);
    }
  })();
</script>
