{% assign home_hero_video_default = 'https://cdn.shopify.com/videos/c/o/v/cd7e30225724449c9a6523df4f7331e2.mp4' %}
{% assign home_hero_video_primary = settings.home_hero_video_primary_url | strip | default: home_hero_video_default %}
{% assign home_hero_video_secondary = settings.home_hero_video_secondary_url | strip %}

<section class="home-page home-page--minimal">
  <div class="home-page__media">
    <video
      class="home-page__video"
      autoplay
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
      {% if home_hero_video_secondary == blank %}
        loop
      {% else %}
        data-home-hero-video
        data-home-hero-video-primary="{{ home_hero_video_primary | escape }}"
        data-home-hero-video-secondary="{{ home_hero_video_secondary | escape }}"
      {% endif %}
    >
      <source src="{{ home_hero_video_primary | escape }}" type="video/mp4">
    </video>
    <div class="home-page__media-intro" aria-hidden="true"></div>
    <a class="home-page__explore-button" href="{{ routes.root_url }}">EXPLORE</a>
  </div>
  <section class="home-collections" aria-label="Jewelry collections" data-home-collections>
    <div class="home-collections__top">
      <h2 class="home-collections__heading">SHOP BY COLLECTION</h2>
      <div class="home-collections__line" aria-hidden="true"></div>
    </div>

    <div class="home-collections__frame">
      <div class="home-collections__controls">
        <button class="home-collections__control" type="button" aria-label="Previous collections" data-home-collections-prev>
          <span aria-hidden="true">‹</span>
        </button>
        <button class="home-collections__control" type="button" aria-label="Next collections" data-home-collections-next>
          <span aria-hidden="true">›</span>
        </button>
      </div>
      <div class="home-collections__viewport" data-home-collections-viewport tabindex="0" aria-label="Jewelry categories slider">
        <div class="home-collections__track">
          {% assign home_collections_menu = linklists['header-subnavv'] %}
          {% assign home_collections_has_links = false %}

          {% if home_collections_menu and home_collections_menu.links.size > 0 %}
            {% for link in home_collections_menu.links %}
              {% if link.type == 'collection_link' %}
                {% assign home_collections_has_links = true %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if home_collections_has_links %}
            {% for link in home_collections_menu.links %}
              {% if link.type == 'collection_link' %}
                {% assign jewelry_collection = link.object %}
                {% assign card_title = jewelry_collection.title | default: link.title %}
                {% assign card_url = link.url %}
                {% assign card_image = blank %}

                {% if jewelry_collection %}
                  {% assign card_image = jewelry_collection.image | default: jewelry_collection.featured_image %}
                  {% if card_image == blank and jewelry_collection.products.first %}
                    {% assign card_image = jewelry_collection.products.first.featured_media.preview_image | default: jewelry_collection.products.first.featured_image %}
                  {% endif %}
                {% endif %}

                <a class="home-collections__card" href="{{ card_url }}">
                  {% if card_image != blank %}
                    <img
                      class="home-collections__image"
                      src="{{ card_image | image_url: width: 1600 }}"
                      alt="{{ card_title }}"
                      loading="lazy"
                      width="800"
                      height="1120"
                    >
                  {% else %}
                    <span class="home-collections__image home-collections__image--fallback" aria-hidden="true"></span>
                  {% endif %}
                  <span class="home-collections__shade" aria-hidden="true"></span>
                  <span class="home-collections__content">
                    <span class="home-collections__title">{{ card_title }}</span>
                    <span class="home-collections__cta">EXPLORE</span>
                  </span>
                </a>
              {% endif %}
            {% endfor %}
          {% else %}
            {% assign jewelry_entries = 'earrings:EARRINGS|rings:RINGS|necklaces:NECKLACE|bracelets:BRACELETS|watches:WATCHES' | split: '|' %}
            {% for entry in jewelry_entries %}
              {% assign parts = entry | split: ':' %}
              {% assign handle = parts[0] %}
              {% assign card_title = parts[1] %}
              {% assign jewelry_collection = collections[handle] %}
              {% assign card_url = '/collections/' | append: handle %}
              {% assign card_image = blank %}

              {% if jewelry_collection %}
                {% assign card_url = jewelry_collection.url %}
                {% assign card_title = jewelry_collection.title | default: card_title %}
                {% assign card_image = jewelry_collection.image | default: jewelry_collection.featured_image %}
                {% if card_image == blank and jewelry_collection.products.first %}
                  {% assign card_image = jewelry_collection.products.first.featured_media.preview_image | default: jewelry_collection.products.first.featured_image %}
                {% endif %}
              {% endif %}

              <a class="home-collections__card" href="{{ card_url }}">
                {% if card_image != blank %}
                  <img
                    class="home-collections__image"
                    src="{{ card_image | image_url: width: 1600 }}"
                    alt="{{ card_title }}"
                    loading="lazy"
                    width="800"
                    height="1120"
                  >
                {% else %}
                  <span class="home-collections__image home-collections__image--fallback" aria-hidden="true"></span>
                {% endif %}
                <span class="home-collections__shade" aria-hidden="true"></span>
                <span class="home-collections__content">
                  <span class="home-collections__title">{{ card_title }}</span>
                  <span class="home-collections__cta">EXPLORE</span>
                </span>
              </a>
            {% endfor %}
          {% endif %}
        </div>
      </div>
      <div class="home-collections__pagination" data-home-collections-pagination aria-label="Carousel progress"></div>
    </div>
  </section>

  {% assign home_stl_home_sets = shop.metafields.custom.home_shop_the_look_sets.value %}
  {% assign home_stl_global_sets = shop.metafields.custom.shop_the_look_sets.value %}
  {% assign home_stl_sets = home_stl_home_sets | default: home_stl_global_sets %}
  {% assign home_stl_primary_set = shop.metafields.custom.home_shop_the_look_set.value %}
  {% assign home_stl_secondary_set = shop.metafields.custom.shop_the_look_set.value %}
  {% assign home_stl_fallback_set = home_stl_primary_set | default: home_stl_secondary_set %}

  {% assign home_stl_editor_handles_raw = settings.home_stl_look_handles | default: '' %}
  {% assign home_stl_editor_handles = '' | split: '' %}
  {% assign home_stl_uses_editor_handles = false %}
  {% if home_stl_editor_handles_raw != blank %}
    {% assign home_stl_editor_handles = home_stl_editor_handles_raw | newline_to_br | split: '<br />' %}
    {% assign home_stl_editor_resolved_count = 0 %}
    {% for home_stl_editor_handle_line in home_stl_editor_handles %}
      {% assign home_stl_editor_handle = home_stl_editor_handle_line | strip %}
      {% if home_stl_editor_handle != blank and metaobjects.look_set[home_stl_editor_handle] != blank %}
        {% assign home_stl_editor_resolved_count = home_stl_editor_resolved_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if home_stl_editor_resolved_count > 0 %}
      {% assign home_stl_sets = home_stl_editor_handles %}
      {% assign home_stl_uses_editor_handles = true %}
    {% endif %}
  {% endif %}

  {% assign home_stl_has_distinct_legacy = false %}
  {% if home_stl_primary_set != blank and home_stl_secondary_set != blank and home_stl_primary_set.id != home_stl_secondary_set.id %}
    {% assign home_stl_has_distinct_legacy = true %}
  {% endif %}

  {% assign home_stl_has_legacy_pair = false %}
  {% if home_stl_uses_editor_handles == false %}
    {% assign home_stl_sets_count = 0 %}
    {% if home_stl_sets != blank %}
      {% assign home_stl_sets_count = home_stl_sets.size %}
    {% endif %}
    {% if home_stl_has_distinct_legacy and home_stl_sets_count < 2 %}
      {% assign home_stl_has_legacy_pair = true %}
      {% assign home_stl_sets = blank %}
    {% endif %}
  {% endif %}

  {% comment %}
    SINGLE-PASS RESOLUTION
    Build home_stl_resolved_handles — a newline-delimited string of handles
    for looks that proved valid (image + ≥1 product). Both the chip switcher
    and panels split this string to iterate — guaranteeing identical counts.
    Handles are stored as "type:handle" so we know how to re-resolve them:
      - "mo:handle"   → metaobjects.look_set[handle]
      - "mf:primary"  → home_stl_primary_set
      - "mf:secondary" → home_stl_secondary_set
      - "mf:fallback" → home_stl_fallback_set
    Count is tracked separately as home_stl_total_looks.
  {% endcomment %}
  {% assign home_stl_resolved_handles = '' %}
  {% assign home_stl_total_looks = 0 %}

  {% if home_stl_uses_editor_handles or home_stl_sets != blank %}
    {% comment %} Path A: editor handles or list-type metafield sets {% endcomment %}
    {% for home_stl_raw_item in home_stl_sets %}
      {% if home_stl_uses_editor_handles %}
        {% assign home_stl_item_handle = home_stl_raw_item | strip %}
        {% if home_stl_item_handle != blank %}
          {% assign home_stl_item_set = metaobjects.look_set[home_stl_item_handle] %}
        {% else %}
          {% assign home_stl_item_set = blank %}
        {% endif %}
      {% else %}
        {% assign home_stl_item_set = home_stl_raw_item %}
        {% assign home_stl_item_handle = home_stl_item_set.system.handle | default: home_stl_item_set.handle %}
      {% endif %}

      {% if home_stl_item_set != blank %}
        {% assign home_stl_item_image = home_stl_item_set.shop_the_look_image.value | default: home_stl_item_set.image.value | default: home_stl_item_set.shop_the_look_image | default: home_stl_item_set.image %}
        {% assign home_stl_item_products = home_stl_item_set.shop_the_look_products.value | default: home_stl_item_set.products.value | default: home_stl_item_set.shop_the_look_products | default: home_stl_item_set.products %}
        {% assign home_stl_item_product_count = 0 %}
        {% if home_stl_item_products != blank %}
          {% for home_stl_chk_p in home_stl_item_products limit: 4 %}
            {% if home_stl_chk_p != blank %}
              {% assign home_stl_item_product_count = home_stl_item_product_count | plus: 1 %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if home_stl_item_image != blank and home_stl_item_product_count > 0 %}
          {% if home_stl_resolved_handles == '' %}
            {% assign home_stl_resolved_handles = 'mo:' | append: home_stl_item_handle %}
          {% else %}
            {% assign home_stl_resolved_handles = home_stl_resolved_handles | append: '
' | append: 'mo:' | append: home_stl_item_handle %}
          {% endif %}
          {% assign home_stl_total_looks = home_stl_total_looks | plus: 1 %}
        {% endif %}
      {% endif %}
    {% endfor %}

  {% elsif home_stl_has_legacy_pair %}
    {% comment %} Path B: two distinct legacy metafield sets {% endcomment %}
    {% for home_stl_legacy_slot in (1..2) %}
      {% if home_stl_legacy_slot == 1 %}
        {% assign home_stl_item_set = home_stl_primary_set %}
      {% else %}
        {% assign home_stl_item_set = home_stl_secondary_set %}
      {% endif %}
      {% if home_stl_item_set != blank %}
        {% assign home_stl_item_image = home_stl_item_set.shop_the_look_image.value | default: home_stl_item_set.image.value | default: home_stl_item_set.shop_the_look_image | default: home_stl_item_set.image %}
        {% assign home_stl_item_products = home_stl_item_set.shop_the_look_products.value | default: home_stl_item_set.products.value | default: home_stl_item_set.shop_the_look_products | default: home_stl_item_set.products %}
        {% assign home_stl_item_product_count = 0 %}
        {% if home_stl_item_products != blank %}
          {% for home_stl_chk_p in home_stl_item_products limit: 4 %}
            {% if home_stl_chk_p != blank %}
              {% assign home_stl_item_product_count = home_stl_item_product_count | plus: 1 %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if home_stl_item_image != blank and home_stl_item_product_count > 0 %}
          {% assign home_stl_legacy_key = 'mf:primary' %}
          {% if home_stl_legacy_slot == 2 %}{% assign home_stl_legacy_key = 'mf:secondary' %}{% endif %}
          {% if home_stl_resolved_handles == '' %}
            {% assign home_stl_resolved_handles = home_stl_legacy_key %}
          {% else %}
            {% assign home_stl_resolved_handles = home_stl_resolved_handles | append: '
' | append: home_stl_legacy_key %}
          {% endif %}
          {% assign home_stl_total_looks = home_stl_total_looks | plus: 1 %}
        {% endif %}
      {% endif %}
    {% endfor %}

  {% elsif home_stl_fallback_set != blank %}
    {% comment %} Path C: single legacy fallback metafield {% endcomment %}
    {% assign home_stl_item_set = home_stl_fallback_set %}
    {% assign home_stl_item_image = home_stl_item_set.shop_the_look_image.value | default: home_stl_item_set.image.value | default: home_stl_item_set.shop_the_look_image | default: home_stl_item_set.image %}
    {% assign home_stl_item_products = home_stl_item_set.shop_the_look_products.value | default: home_stl_item_set.products.value | default: home_stl_item_set.shop_the_look_products | default: home_stl_item_set.products %}
    {% assign home_stl_item_product_count = 0 %}
    {% if home_stl_item_products != blank %}
      {% for home_stl_chk_p in home_stl_item_products limit: 4 %}
        {% if home_stl_chk_p != blank %}
          {% assign home_stl_item_product_count = home_stl_item_product_count | plus: 1 %}
        {% endif %}
      {% endfor %}
    {% endif %}
    {% if home_stl_item_image != blank and home_stl_item_product_count > 0 %}
      {% assign home_stl_resolved_handles = 'mf:fallback' %}
      {% assign home_stl_total_looks = 1 %}
    {% endif %}
  {% endif %}

  {% comment %} ---- RENDER ---- {% endcomment %}
  {% if home_stl_total_looks > 0 %}
    <div class="shop-the-look-group" data-stl-group data-stl-section>
      <div class="shop-the-look-group__top home-collections__top">
        <h2 class="home-collections__heading shop-the-look-group__heading">SHOP <span class="shop-the-look-group__heading-script">the Look</span></h2>
        <div class="home-collections__line" aria-hidden="true"></div>
      </div>

      {% comment %} Panels — same resolved handles list, guaranteed matching count {% endcomment %}
      {% assign home_stl_panel_idx = 0 %}
      {% assign home_stl_handle_lines = home_stl_resolved_handles | newline_to_br | split: '<br />' %}
      {% for home_stl_handle_line in home_stl_handle_lines %}
        {% assign home_stl_handle_entry = home_stl_handle_line | strip %}
        {% assign home_stl_panel_set = blank %}
        {% if home_stl_handle_entry == 'mf:primary' %}
          {% assign home_stl_panel_set = home_stl_primary_set %}
        {% elsif home_stl_handle_entry == 'mf:secondary' %}
          {% assign home_stl_panel_set = home_stl_secondary_set %}
        {% elsif home_stl_handle_entry == 'mf:fallback' %}
          {% assign home_stl_panel_set = home_stl_fallback_set %}
        {% else %}
          {% assign home_stl_mo_handle = home_stl_handle_entry | remove_first: 'mo:' %}
          {% assign home_stl_panel_set = metaobjects.look_set[home_stl_mo_handle] %}
        {% endif %}

        {% if home_stl_panel_set != blank %}
          {% assign home_stl_title = 'Shop The Look' %}
          {% assign home_stl_set_title = home_stl_panel_set.shop_the_look_title.value | default: home_stl_panel_set.title.value | default: home_stl_panel_set.shop_the_look_title | default: home_stl_panel_set.title %}
          {% if home_stl_set_title != blank %}
            {% assign home_stl_title = home_stl_set_title %}
          {% endif %}
          {% assign home_stl_image = home_stl_panel_set.shop_the_look_image.value | default: home_stl_panel_set.image.value | default: home_stl_panel_set.shop_the_look_image | default: home_stl_panel_set.image %}
          {% assign home_stl_products = home_stl_panel_set.shop_the_look_products.value | default: home_stl_panel_set.products.value | default: home_stl_panel_set.shop_the_look_products | default: home_stl_panel_set.products %}
          {% assign home_stl_hotspots = home_stl_panel_set.shop_the_look_hotspots.value | default: home_stl_panel_set.hotspots.value | default: home_stl_panel_set.shop_the_look_hotspots | default: home_stl_panel_set.hotspots %}
          {% assign home_stl_is_hidden = false %}
          {% if home_stl_panel_idx > 0 %}{% assign home_stl_is_hidden = true %}{% endif %}
          {% render 'home-shop-the-look-panel',
            stl_title: home_stl_title,
            stl_image: home_stl_image,
            stl_products: home_stl_products,
            stl_hotspots: home_stl_hotspots,
            stl_index: home_stl_panel_idx,
            stl_hidden: home_stl_is_hidden,
            stl_grouped: home_stl_total_looks > 1,
            stl_total_looks: home_stl_total_looks
          %}
          {% assign home_stl_panel_idx = home_stl_panel_idx | plus: 1 %}
        {% endif %}
      {% endfor %}

    </div>
  {% endif %}

  <section class="home-story" data-home-story>
    <div class="home-story__sticky">
      <div class="home-story__pronunciation">
        <span class="home-story__ipa">/keɪˈliːnə/</span>
        <span class="home-story__phonetic">[kay·LEE·nah]</span>
      </div>
      <div class="home-story__name" data-home-story-name>Caelina</div>
      <p class="home-story__text" data-home-story-text>
        A name from Latin CAELUM &mdash; sky; heaven, evoking grace, divine elegance, and celestial beauty.
      </p>
    </div>
  </section>
</section>

<script>
  (function initHomeCollectionsCarousel() {
    var sections = document.querySelectorAll("[data-home-collections]");
    if (!sections.length) return;
    var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    var autoplayDelay = 2300;

    sections.forEach(function (section) {
      var viewport = section.querySelector("[data-home-collections-viewport]");
      var prev = section.querySelector("[data-home-collections-prev]");
      var next = section.querySelector("[data-home-collections-next]");
      var track = section.querySelector(".home-collections__track");
      var pagination = section.querySelector("[data-home-collections-pagination]");
      if (!viewport || !prev || !next || !track || !pagination) return;
      var pageCount = 1;
      var currentIndex = 0;
      var scrollPoints = [0];
      var dots = [];
      var rafId = null;
      var lastFrameAt = 0;
      var elapsedInCycle = 0;
      var suppressScrollResetUntil = 0;
      var lastUserGestureAt = 0;
      var hasResetForGesture = false;

      function getMaxScroll() {
        return Math.max(0, viewport.scrollWidth - viewport.clientWidth);
      }

      function rebuildScrollPoints() {
        var cards = track.querySelectorAll(".home-collections__card");
        var maxScroll = getMaxScroll();
        var nextPoints = [0];
        var viewportRect = viewport.getBoundingClientRect();
        var currentScroll = viewport.scrollLeft;

        cards.forEach(function (card) {
          var cardRect = card.getBoundingClientRect();
          var left = currentScroll + (cardRect.left - viewportRect.left);
          left = Math.min(maxScroll, Math.max(0, left));
          if (Math.abs(left - nextPoints[nextPoints.length - 1]) > 2) {
            nextPoints.push(left);
          }
        });

        if (Math.abs(maxScroll - nextPoints[nextPoints.length - 1]) > 1) {
          nextPoints.push(maxScroll);
        }

        scrollPoints = nextPoints;
        pageCount = Math.max(1, scrollPoints.length);
      }

      function getCurrentIndex() {
        var left = viewport.scrollLeft;
        var closestIndex = 0;
        var closestDistance = Infinity;

        scrollPoints.forEach(function (point, index) {
          var distance = Math.abs(point - left);
          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        return closestIndex;
      }

      function setProgress(progress) {
        var clamped = Math.max(0, Math.min(1, progress));
        dots.forEach(function (dot, index) {
          dot.style.setProperty("--progress", index === currentIndex ? clamped : 0);
        });
      }

      function updateActiveDot() {
        dots.forEach(function (dot, index) {
          var isActive = index === currentIndex;
          dot.classList.toggle("is-active", isActive);
          dot.setAttribute("aria-current", isActive ? "true" : "false");
        });
      }

      function buildDots() {
        pagination.innerHTML = "";
        dots = [];

        for (var i = 0; i < pageCount; i += 1) {
          var dot = document.createElement("button");
          dot.type = "button";
          dot.className = "home-collections__dot";
          dot.setAttribute("aria-label", "Go to slide " + (i + 1));
          dot.innerHTML = '<span class="home-collections__dot-fill" aria-hidden="true"></span>';
          dot.dataset.index = i;
          dot.addEventListener("click", function () {
            var targetIndex = Number(this.dataset.index);
            runManualNavigation(function () {
              scrollToIndex(targetIndex);
            });
          });
          pagination.appendChild(dot);
          dots.push(dot);
        }

        pagination.classList.toggle("is-single", pageCount <= 1);
      }

      function updateControls() {
        currentIndex = getCurrentIndex();
        var hasMultiplePages = pageCount > 1;
        prev.disabled = !hasMultiplePages;
        next.disabled = !hasMultiplePages;
        updateActiveDot();
      }

      function scrollToIndex(index) {
        var targetIndex = Math.min(pageCount - 1, Math.max(0, index));
        var targetLeft = scrollPoints[targetIndex] || 0;
        suppressScrollResetUntil = performance.now() + 500;
        viewport.scrollTo({ left: targetLeft, behavior: "smooth" });
      }

      function scrollByStep(direction) {
        if (pageCount <= 1) return;
        var nextIndex = getCurrentIndex() + direction;
        if (nextIndex > pageCount - 1) nextIndex = 0;
        if (nextIndex < 0) nextIndex = pageCount - 1;
        scrollToIndex(nextIndex);
      }

      function canAutoplay() {
        return pageCount > 1;
      }

      function resetTimer() {
        elapsedInCycle = 0;
        lastFrameAt = performance.now();
        setProgress(0);
      }

      function stopTimer() {
        if (!rafId) return;
        cancelAnimationFrame(rafId);
        rafId = null;
      }

      function runManualNavigation(navigate) {
        stopTimer();
        navigate();
        resetTimer();
        startTimer();
      }

      function noteUserGesture() {
        lastUserGestureAt = performance.now();
        hasResetForGesture = false;
      }

      function maybeResetTimerForUserScroll() {
        var now = performance.now();
        var gestureIsRecent = now - lastUserGestureAt < 900;
        if (!gestureIsRecent || hasResetForGesture) return;
        if (now < suppressScrollResetUntil) return;
        hasResetForGesture = true;
        stopTimer();
        resetTimer();
        startTimer();
      }

      function tick(now) {
        if (!canAutoplay()) {
          stopTimer();
          resetTimer();
          return;
        }

        var delta = Math.min(120, Math.max(0, now - lastFrameAt));
        lastFrameAt = now;

        if (!document.hidden) {
          elapsedInCycle += delta;
        }

        setProgress(elapsedInCycle / autoplayDelay);

        if (elapsedInCycle >= autoplayDelay) {
          elapsedInCycle = 0;
          scrollToIndex((currentIndex + 1) % pageCount);
        }

        rafId = requestAnimationFrame(tick);
      }

      function startTimer() {
        if (rafId || !canAutoplay()) return;
        lastFrameAt = performance.now();
        rafId = requestAnimationFrame(tick);
      }

      function recalc() {
        var previousPageCount = pageCount;
        rebuildScrollPoints();
        var countChanged = pageCount !== previousPageCount;

        if (countChanged) {
          buildDots();
          resetTimer();
        }

        updateControls();

        if (canAutoplay()) {
          startTimer();
        } else {
          stopTimer();
          resetTimer();
        }
      }

      prev.addEventListener("click", function () {
        runManualNavigation(function () {
          scrollByStep(-1);
        });
      });

      next.addEventListener("click", function () {
        runManualNavigation(function () {
          scrollByStep(1);
        });
      });

      viewport.addEventListener("scroll", function () {
        updateControls();
        maybeResetTimerForUserScroll();
      }, { passive: true });
      viewport.addEventListener("touchstart", noteUserGesture, { passive: true });
      viewport.addEventListener("pointerdown", noteUserGesture);
      viewport.addEventListener("wheel", noteUserGesture, { passive: true });
      window.addEventListener("resize", recalc);
      window.addEventListener("load", recalc);
      track.querySelectorAll("img").forEach(function (img) {
        if (img.complete) return;
        img.addEventListener("load", recalc, { once: true });
      });
      viewport.addEventListener("keydown", function (event) {
        if (event.key === "ArrowLeft") {
          runManualNavigation(function () {
            scrollByStep(-1);
          });
        }
        if (event.key === "ArrowRight") {
          runManualNavigation(function () {
            scrollByStep(1);
          });
        }
      });
      document.addEventListener("visibilitychange", function () {
        if (!document.hidden) {
          lastFrameAt = performance.now();
        }
      });

      if (typeof prefersReducedMotion.addEventListener === "function") {
        prefersReducedMotion.addEventListener("change", recalc);
      } else if (typeof prefersReducedMotion.addListener === "function") {
        prefersReducedMotion.addListener(recalc);
      }

      rebuildScrollPoints();
      buildDots();
      updateControls();
      startTimer();
    });
  })();
</script>

<script>
  (function initHomeStoryReveal() {
    var sections = document.querySelectorAll("[data-home-story]");
    if (!sections.length) return;

    var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    var darkColor = [26, 26, 31];
    var lightColor = [244, 244, 248];
    var revealLead = 0.9;
    var entries = [];
    var ticking = false;

    function clamp(value, min, max) {
      return Math.max(min, Math.min(max, value));
    }

    function mixChannel(start, end, amount) {
      return Math.round(start + (end - start) * amount);
    }

    function toRgb(amount) {
      var r = mixChannel(darkColor[0], lightColor[0], amount);
      var g = mixChannel(darkColor[1], lightColor[1], amount);
      var b = mixChannel(darkColor[2], lightColor[2], amount);
      return "rgb(" + r + ", " + g + ", " + b + ")";
    }

    function buildWords(textNode) {
      var text = textNode.textContent.replace(/\s+/g, " ").trim();
      if (!text) return [];

      var words = text.split(" ");
      var fragment = document.createDocumentFragment();
      var spans = [];
      var forcedBreakAfter = {
        latin: 0,
        heaven: 0,
        grace: 0,
        elegance: 0
      };

      words.forEach(function (word, index) {
        var span = document.createElement("span");
        var normalizedWord = word.toLowerCase().replace(/[^a-z0-9]+/g, "");
        span.className = "home-story__word home-story__word--typewriter";
        if (normalizedWord === "sky" || normalizedWord === "heaven") {
          span.classList.add("home-story__word--typewriter-italic");
        }
        span.textContent = word;
        fragment.appendChild(span);
        if (index < words.length - 1) {
          if (Object.prototype.hasOwnProperty.call(forcedBreakAfter, normalizedWord) && forcedBreakAfter[normalizedWord] === 0) {
            forcedBreakAfter[normalizedWord] = 1;
            fragment.appendChild(document.createElement("br"));
          } else {
            fragment.appendChild(document.createTextNode(" "));
          }
        }
        spans.push(span);
      });

      textNode.textContent = "";
      textNode.appendChild(fragment);
      return spans;
    }

    function buildEntries() {
      entries = [];
      sections.forEach(function (section) {
        var textNode = section.querySelector("[data-home-story-text]");
        var pronunciationNodes = section.querySelectorAll(".home-story__pronunciation span");
        var nameNode = section.querySelector("[data-home-story-name]");
        if (!textNode) return;

        entries.push({
          section: section,
          words: buildWords(textNode),
          pronunciationNodes: pronunciationNodes,
          nameNode: nameNode,
          lastProgress: -1
        });
      });
    }

    function getProgress(section) {
      var rect = section.getBoundingClientRect();
      var travel = Math.max(1, rect.height - window.innerHeight);
      return clamp((-rect.top) / travel, 0, 1);
    }

    function renderEntry(entry, progress) {
      var revealProgress = clamp(Math.pow(progress, 0.8), 0, 1);
      var revealPosition = revealProgress * (entry.words.length + revealLead);
      var pronunciationAmount = clamp(revealProgress * 1.15, 0, 1);
      var nameAmount = clamp((revealProgress - 0.02) * 20, 0, 1);

      entry.words.forEach(function (word, index) {
        var amount = clamp(revealPosition - index, 0, 1);
        word.style.color = toRgb(amount);
      });

      if (entry.pronunciationNodes && entry.pronunciationNodes.length) {
        entry.pronunciationNodes.forEach(function (node) {
          node.style.color = toRgb(pronunciationAmount);
        });
      }

      if (entry.nameNode) {
        entry.nameNode.style.color = toRgb(nameAmount);
      }
    }

    function update() {
      ticking = false;

      entries.forEach(function (entry) {
        var progress = prefersReducedMotion.matches ? 1 : getProgress(entry.section);
        if (Math.abs(progress - entry.lastProgress) < 0.001) return;
        entry.lastProgress = progress;
        renderEntry(entry, progress);
      });
    }

    function requestUpdate() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }

    buildEntries();
    requestUpdate();

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    window.addEventListener("load", requestUpdate);
    document.addEventListener("visibilitychange", requestUpdate);

    if (typeof prefersReducedMotion.addEventListener === "function") {
      prefersReducedMotion.addEventListener("change", requestUpdate);
    } else if (typeof prefersReducedMotion.addListener === "function") {
      prefersReducedMotion.addListener(requestUpdate);
    }
  })();
</script>
