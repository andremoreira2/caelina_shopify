<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ shop.name }} — Coming soon</title>
    <meta name="description" content="{{ page_description | default: shop.password_message | strip_html | escape }}">
    <meta name="theme-color" content="#f4efe5">

    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Montserrat:wght@200;300;400&display=swap" rel="stylesheet">

    {{ content_for_header }}
    {{ 'password.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'password.js' | asset_url }}" defer="defer"></script>
  </head>
  <body class="template-password">
    <a class="password-skip-link" href="#PasswordMain">Skip to content</a>
    {{ content_for_layout }}
  </body>
</html>
