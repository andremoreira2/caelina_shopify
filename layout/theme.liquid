<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  
  <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-LCYS2Q3ZYL"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-LCYS2Q3ZYL');
</script>

  <!-- Performance: Preconnect to external domains -->
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="dns-prefetch" href="https://cdn.shopify.com">

  {% if page_description %}
    <meta name="description" content="{{ page_description }}">
  {% endif %}
  
  {%- comment -%} Favicon & App Icons {%- endcomment -%}
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
  <meta name="theme-color" content="#0b0b0f">
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ page_title }}</title>
  <style>
    @font-face {
      font-family: "Mayonice";
      src:
        url("{{ 'Mayonice.woff2' | asset_url }}") format("woff2"),
        url("{{ 'Mayonice.ttf' | asset_url }}") format("truetype");
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
  </style>
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}{% if template.name == 'page' and template.suffix == 'home' %} template-home{% endif %}">
  <header class="site-header" role="banner">
    <div class="site-announcement-bar" role="note" aria-label="Store announcement">
      <span>FREE WORLDWIDE SHIPPING</span>
      <span class="site-announcement-bar__divider" aria-hidden="true">|</span>
      <span>SIGN UP &amp; GET A 35$ GIFT</span>
    </div>
    <div class="site-header__inner">
      <div class="site-header__left">
        <a class="site-header__icon site-header__home" href="/pages/home" aria-label="Home">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </a>
        <a href="/search" class="site-header__icon" aria-label="Search">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="M16.2 16.2L21 21" stroke-linecap="round"></path>
          </svg>
        </a>
      </div>
      <div class="site-header__center">
        <a class="site-header__logo" id="brandLogo" href="{{ routes.root_url }}" aria-label="CAELINA home">CΛELINΛ</a>
        <nav class="site-subnav" aria-label="Collections">
          {% assign subnav = linklists['header-subnavv'] %}
          {% if subnav and subnav.links.size > 0 %}
            {% for link in subnav.links %}
              <a href="{{ link.url }}" class="site-subnav__link{% if link.current or link.active or link.child_active %} is-active{% endif %}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {% endfor %}
          {% endif %}
        </nav>
      </div>
      <nav class="site-nav" aria-label="Primary">
        <a href="{{ routes.cart_url }}" class="site-cart" data-cart-toggle>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
          </svg>
          {% if cart.item_count > 0 %}
            <span class="site-cart__count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </nav>
    </div>
    <div class="site-header__mobile" aria-label="Mobile header">
      <div class="site-header__mobile-left">
        <button
          class="site-header__icon site-header__menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-controls="MobileMenu"
          aria-expanded="false"
          aria-haspopup="dialog"
          data-mobile-menu-toggle
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
        <a class="site-header__icon site-header__home" href="/pages/home" aria-label="Home">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </a>
      </div>
      <a class="site-header__brand" href="{{ routes.root_url }}">CΛELINΛ</a>
      <div class="site-header__mobile-right">
        <a class="site-header__icon" href="/search" aria-label="Search">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path d="M16.2 16.2L21 21" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </a>
        <a class="site-header__icon site-header__cart" href="{{ routes.cart_url }}" aria-label="Cart" data-cart-toggle>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
          </svg>
          {% if cart.item_count > 0 %}
            <span class="site-cart__count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>
    </div>
  </header>
  {% assign mobile_menu = linklists['header-subnavv'] %}
  <div class="mobile-menu" data-mobile-menu aria-hidden="true">
    <div class="mobile-menu__overlay" data-mobile-menu-close></div>
    <div class="mobile-menu__panel" id="MobileMenu" role="dialog" aria-modal="true" aria-labelledby="MobileMenuTitle" tabindex="-1">
      <div class="mobile-menu__frame">
        <header class="mobile-menu__header">
          <a class="mobile-menu__brand" href="{{ routes.root_url }}" data-mobile-menu-close>CΛELINΛ</a>
          <button class="mobile-menu__close" type="button" aria-label="Close menu" data-mobile-menu-close>Close</button>
        </header>
        <div class="mobile-menu__body">
          <p class="mobile-menu__eyebrow" id="MobileMenuTitle">Collections</p>
          <nav class="mobile-menu__nav" aria-label="Mobile collections">
            {% if mobile_menu and mobile_menu.links.size > 0 %}
              {% for link in mobile_menu.links %}
                <a
                  href="{{ link.url }}"
                  class="mobile-menu__link{% if link.current or link.active or link.child_active %} is-active{% endif %}"
                  {% if link.current %} aria-current="page"{% endif %}
                  data-mobile-menu-close
                >
                  {{ link.title }}
                </a>
              {% endfor %}
            {% else %}
              {% assign jewelry_entries = 'earrings:Earrings|rings:Rings|necklaces:Necklaces|bracelets:Bracelets|watches:Watches' | split: '|' %}
              {% for entry in jewelry_entries %}
                {% assign parts = entry | split: ':' %}
                {% assign handle = parts[0] %}
                {% assign label = parts[1] %}
                <a href="/collections/{{ handle }}" class="mobile-menu__link" data-mobile-menu-close>{{ label }}</a>
              {% endfor %}
            {% endif %}
          </nav>
        </div>
        <footer class="mobile-menu__footer">
          <nav class="mobile-menu__utility" aria-label="Store links">
            <a class="mobile-menu__utility-link" href="/pages/home" data-mobile-menu-close>Home</a>
            <a class="mobile-menu__utility-link" href="/search" data-mobile-menu-close>Search</a>
            <a class="mobile-menu__utility-link" href="/account" data-mobile-menu-close>Account</a>
            <a class="mobile-menu__utility-link" href="{{ routes.cart_url }}" aria-expanded="false" aria-haspopup="dialog" data-cart-toggle data-mobile-menu-close>Cart</a>
          </nav>
          <div class="mobile-menu__notes" aria-label="Store highlights">
            <p class="mobile-menu__note">Free worldwide shipping</p>
            <p class="mobile-menu__note">Sign up and get a $35 gift</p>
          </div>
        </footer>
      </div>
    </div>
  </div>
  {{ content_for_layout }}

  {% unless template.name == 'index' %}
    <footer class="site-footer" role="contentinfo">
      <div class="site-footer__inner">
        <div class="site-footer__grid">
          <div class="site-footer__column site-footer__column--newsletter">
            <h2 class="site-footer__heading">Newsletter</h2>
            <p class="site-footer__text">Get early access to drops and private offers.</p>
            {% form 'customer', class: 'site-footer__newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="site-footer__newsletter-fields">
                <label for="FooterNewsletterEmail" class="visually-hidden">Email</label>
                <input
                  id="FooterNewsletterEmail"
                  type="email"
                  name="contact[email]"
                  value="{% if customer %}{{ customer.email }}{% endif %}"
                  placeholder="Enter your email"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  required
                >
                <button type="submit">Subscribe</button>
              </div>
              {%- if form.posted_successfully? -%}
                <p class="site-footer__message site-footer__message--success" tabindex="-1" autofocus>Thanks for subscribing.</p>
              {%- elsif form.errors -%}
                <div class="site-footer__message site-footer__message--error" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
              {%- endif -%}
            {% endform %}
          </div>

          <div class="site-footer__column">
            <h2 class="site-footer__heading">Shop</h2>
            <ul class="site-footer__links" role="list">
              {% assign footer_shop_links = linklists['header-subnavv'] %}
              {% if footer_shop_links and footer_shop_links.links.size > 0 %}
                {% for link in footer_shop_links.links %}
                  <li>
                    <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
                  </li>
                {% endfor %}
              {% else %}
                <li><a href="/collections/earrings">Earrings</a></li>
                <li><a href="/collections/rings">Rings</a></li>
              {% endif %}
            </ul>
          </div>

        </div>

      </div>

      <div class="site-footer__meta">
        <p>© {{ 'now' | date: '%Y' }} CAELINA. All rights reserved.</p>
        <ul class="site-footer__payments site-footer__payments--bottom" role="list" aria-label="Payment methods">
          {% assign enabled_payments = shop.enabled_payment_types %}
          {% if enabled_payments and enabled_payments.size > 0 %}
            {% for type in enabled_payments %}
              <li class="site-footer__payment">{{ type | payment_type_svg_tag }}</li>
            {% endfor %}
          {% else %}
            <li class="site-footer__payment">{{ 'visa' | payment_type_svg_tag }}</li>
            <li class="site-footer__payment">{{ 'master' | payment_type_svg_tag }}</li>
            <li class="site-footer__payment">{{ 'american_express' | payment_type_svg_tag }}</li>
            <li class="site-footer__payment">{{ 'paypal' | payment_type_svg_tag }}</li>
          {% endif %}
        </ul>
      </div>

      <div class="site-footer__brand" aria-hidden="true">
        <span class="site-footer__brand-wordmark">CΛELINΛ</span>
      </div>
    </footer>
  {% endunless %}

  <div class="cart-drawer" data-cart-drawer aria-hidden="true">
    <div class="cart-drawer__overlay" data-cart-drawer-close></div>
    <div class="cart-drawer__panel" role="dialog" aria-label="Cart" aria-modal="true">
      <button class="cart-drawer__close" type="button" data-cart-drawer-close aria-label="Close cart">✕</button>
      <div class="cart-drawer__content" data-cart-drawer-content></div>
    </div>
  </div>

  <div class="search-overlay" data-search-overlay aria-hidden="true">
    <div class="search-overlay__backdrop" data-search-close></div>
    <div class="search-overlay__content">
      <div class="search-overlay__header">
        <div class="search-overlay__input-wrapper">
          <svg class="search-overlay__icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path d="M16.2 16.2L21 21" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <input type="text" class="search-overlay__input" placeholder="Search..." aria-label="Search" data-search-input>
          <button class="search-overlay__close" type="button" aria-label="Close search" data-search-close>✕</button>
        </div>
      </div>
      <div class="search-overlay__results" data-search-results></div>
    </div>
  </div>

  {{ 'cart-drawer.js' | asset_url | script_tag }}
  <script src="{{ 'header-scroll.js' | asset_url }}" defer></script>
  <script src="{{ 'search.js' | asset_url }}" defer></script>
  <script src="{{ 'mobile-menu.js' | asset_url }}" defer></script>
  {% if template.name == 'product' or (template.name == 'page' and template.suffix == 'home') %}
    <script src="{{ 'shop-the-look.js' | asset_url }}" defer></script>
  {% endif %}
  {% if template.name == 'page' and template.suffix == 'home' %}
    <script src="{{ 'home-hero-video.js' | asset_url }}" defer></script>
  {% endif %}
  {% if template.name == 'index' %}
    <script src="{{ 'app.js' | asset_url }}" defer></script>
  {% endif %}
</body>
</html>
