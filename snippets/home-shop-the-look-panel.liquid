{% assign stl_product_count = 0 %}
{% if stl_products != blank %}
  {% for stl_product in stl_products limit: 4 %}
    {% if stl_product != blank %}
      {% assign stl_product_count = stl_product_count | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if stl_image != blank and stl_product_count > 0 %}
  <section
    class="shop-the-look shop-the-look--home{% if stl_grouped %} shop-the-look--grouped{% endif %}"
    data-shop-the-look
    data-stl-look-panel
    data-look-index="{{ stl_index }}"
    id="home-stl-look-{{ stl_index }}"
    aria-hidden="{% if stl_hidden %}true{% else %}false{% endif %}"
    {% if stl_hidden %}hidden{% endif %}
  >
    <div class="shop-the-look__inner">
      <div class="shop-the-look__layout">
        <div class="shop-the-look__media-column">
          {% if stl_grouped and stl_total_looks > 1 %}
            {% assign stl_last_index = stl_total_looks | minus: 1 %}
            <div class="shop-the-look-switcher" aria-label="Browse looks">
              <button
                class="shop-the-look-switcher__arrow"
                type="button"
                data-stl-group-prev
                aria-label="Show previous look"
                {% if stl_index == 0 %}disabled{% endif %}
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  <polyline points="10,3 5,8 10,13" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="shop-the-look-switcher__track" role="tablist" aria-label="Available looks">
                {% for stl_chip_num in (1..stl_total_looks) %}
                  {% assign stl_chip_idx = forloop.index0 %}
                  <button
                    class="shop-the-look-switcher__chip{% if stl_chip_idx == stl_index %} is-active{% endif %}"
                    type="button"
                    role="tab"
                    data-stl-group-trigger
                    data-look-index="{{ stl_chip_idx }}"
                    aria-controls="home-stl-look-{{ stl_chip_idx }}"
                    aria-pressed="{% if stl_chip_idx == stl_index %}true{% else %}false{% endif %}"
                    aria-selected="{% if stl_chip_idx == stl_index %}true{% else %}false{% endif %}"
                  >
                    Look {{ stl_chip_num }}
                  </button>
                {% endfor %}
              </div>
              <button
                class="shop-the-look-switcher__arrow"
                type="button"
                data-stl-group-next
                aria-label="Show next look"
                {% if stl_index >= stl_last_index %}disabled{% endif %}
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  <polyline points="6,3 11,8 6,13" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          {% endif %}
          <div class="shop-the-look__media-wrap" style="--stl-image-ratio: {{ stl_image.aspect_ratio | default: 0.8571428571 }};">
            <img
              class="shop-the-look__image"
              src="{{ stl_image | image_url: width: 1800 }}"
              alt="{{ stl_title | escape }}"
              loading="lazy"
              width="{{ stl_image.width | default: 1200 }}"
              height="{{ stl_image.height | default: 1400 }}"
            >
            <div class="shop-the-look__dots">
              {% assign stl_dot_index = 0 %}
              {% for stl_product in stl_products limit: 4 %}
                {% if stl_product != blank %}
                  {% assign fallback_x = 50 %}
                  {% assign fallback_y = 50 %}
                  {% case stl_dot_index %}
                    {% when 0 %}
                      {% assign fallback_x = 28 %}
                      {% assign fallback_y = 34 %}
                    {% when 1 %}
                      {% assign fallback_x = 64 %}
                      {% assign fallback_y = 30 %}
                    {% when 2 %}
                      {% assign fallback_x = 70 %}
                      {% assign fallback_y = 62 %}
                    {% when 3 %}
                      {% assign fallback_x = 48 %}
                      {% assign fallback_y = 78 %}
                  {% endcase %}

                  {% assign stl_dot_x = fallback_x %}
                  {% assign stl_dot_y = fallback_y %}
                  {% assign stl_dot_label = stl_product.title %}
                  {% if stl_hotspots != blank and stl_hotspots.size > stl_dot_index %}
                    {% assign stl_hotspot = stl_hotspots[stl_dot_index] %}
                    {% if stl_hotspot.x != blank %}
                      {% assign stl_dot_x = stl_hotspot.x %}
                    {% endif %}
                    {% if stl_hotspot.y != blank %}
                      {% assign stl_dot_y = stl_hotspot.y %}
                    {% endif %}
                    {% if stl_hotspot.label != blank %}
                      {% assign stl_dot_label = stl_hotspot.label %}
                    {% endif %}
                  {% endif %}
                  {% assign stl_dot_number = stl_dot_index | plus: 1 %}
                  {% assign stl_dot_variant = stl_product.selected_or_first_available_variant | default: stl_product.variants.first %}
                  <button
                    class="shop-the-look__dot{% if stl_dot_index == 0 %} is-active{% endif %}"
                    type="button"
                    data-stl-dot
                    data-index="{{ stl_dot_index }}"
                    aria-label="Show {{ stl_dot_label | escape }}"
                    aria-pressed="{% if stl_dot_index == 0 %}true{% else %}false{% endif %}"
                    style="left: {{ stl_dot_x | at_least: 0 | at_most: 100 }}%; top: {{ stl_dot_y | at_least: 0 | at_most: 100 }}%;"
                  >
                    <span class="shop-the-look__dot-num" aria-hidden="true">{{ stl_dot_number }}</span>
                    <span class="shop-the-look__dot-tooltip" aria-hidden="true" data-stl-tooltip>
                      <span class="shop-the-look__dot-tooltip-name">{{ stl_product.title | truncate: 32 }}</span>
                      <span class="shop-the-look__dot-tooltip-price">{{ stl_dot_variant.price | money }}</span>
                    </span>
                  </button>
                  {% assign stl_dot_index = stl_dot_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>

        <div class="shop-the-look__panel">
          {% assign stl_card_index = 0 %}
          {% for stl_product in stl_products limit: 4 %}
            {% if stl_product != blank %}
              {% assign stl_active = false %}
              {% if stl_card_index == 0 %}
                {% assign stl_active = true %}
              {% endif %}
              {% assign stl_variant = stl_product.selected_or_first_available_variant | default: stl_product.variants.first %}
              {% assign stl_product_image = stl_product.featured_image | default: stl_product.images.first %}
              {% assign stl_product_image_count = stl_product.images | size %}
              {% capture stl_variant_select_id %}homeStlVariant-{{ stl_index }}-{{ stl_card_index }}{% endcapture %}
              {% assign stl_card_number = stl_card_index | plus: 1 %}
              <article
                class="shop-the-look__card{% if stl_active %} is-active{% endif %}"
                data-stl-card
                data-index="{{ stl_card_index }}"
              >
                <span class="shop-the-look__card-badge" aria-hidden="true">{{ stl_card_number }}</span>
                <div class="shop-the-look__card-visual">
                  <a class="shop-the-look__card-media" href="{{ stl_product.url }}">
                    {% if stl_product_image != blank %}
                      {% if stl_product_image_count > 1 %}
                        <div class="shop-the-look__card-media-track" data-stl-gallery-track style="--stl-gallery-index: 0;">
                          {% for stl_gallery_image in stl_product.images %}
                            <span
                              class="shop-the-look__card-media-slide"
                              data-stl-gallery-slide
                              aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}"
                            >
                              <img
                                src="{{ stl_gallery_image | image_url: width: 1000 }}"
                                alt="{{ stl_gallery_image.alt | default: stl_product.title | escape }}"
                                loading="lazy"
                                width="{{ stl_gallery_image.width | default: 900 }}"
                                height="{{ stl_gallery_image.height | default: 900 }}"
                              >
                            </span>
                          {% endfor %}
                        </div>
                      {% else %}
                        <img
                          src="{{ stl_product_image | image_url: width: 1000 }}"
                          alt="{{ stl_product_image.alt | default: stl_product.title | escape }}"
                          loading="lazy"
                          width="{{ stl_product_image.width | default: 900 }}"
                          height="{{ stl_product_image.height | default: 900 }}"
                        >
                      {% endif %}
                    {% else %}
                      <span class="shop-the-look__media-fallback" aria-hidden="true"></span>
                    {% endif %}
                  </a>
                  {% if stl_product_image_count > 1 %}
                    <div class="shop-the-look__card-nav" data-stl-gallery-nav>
                      <button
                        type="button"
                        class="shop-the-look__card-nav-button shop-the-look__card-nav-button--prev"
                        data-stl-gallery-prev
                        aria-label="Show previous image for {{ stl_product.title | escape }}"
                      >
                        <svg class="shop-the-look__card-nav-icon" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8.91003 19.9201L15.43 13.4001C16.2 12.6301 16.2 11.3701 15.43 10.6001L8.91003 4.08008" class="shop-the-look__card-nav-arrow"></path>
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="shop-the-look__card-nav-button shop-the-look__card-nav-button--next"
                        data-stl-gallery-next
                        aria-label="Show next image for {{ stl_product.title | escape }}"
                      >
                        <svg class="shop-the-look__card-nav-icon" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8.91003 19.9201L15.43 13.4001C16.2 12.6301 16.2 11.3701 15.43 10.6001L8.91003 4.08008" class="shop-the-look__card-nav-arrow"></path>
                        </svg>
                      </button>
                    </div>
                  {% endif %}
                  <form
                    method="post"
                    action="/cart/add"
                    class="shop-the-look__form"
                    data-stl-product-title="{{ stl_product.title | escape }}"
                    data-stl-requires-choice="{% if stl_product.variants.size > 1 %}true{% else %}false{% endif %}"
                  >
                    {% if stl_product.variants.size > 1 %}
                      <div class="shop-the-look__option-slot shop-the-look__option-slot--hidden">
                        <label class="shop-the-look__label" for="{{ stl_variant_select_id }}">Choose option</label>
                        <select class="shop-the-look__select" id="{{ stl_variant_select_id }}" data-stl-variant-select>
                          {% for variant in stl_product.variants %}
                            <option
                              value="{{ variant.id }}"
                              data-price="{{ variant.price | money }}"
                              data-compare="{{ variant.compare_at_price | money }}"
                              data-price-amount="{{ variant.price }}"
                              data-compare-amount="{{ variant.compare_at_price }}"
                              data-available="{{ variant.available }}"
                              {% if variant.id == stl_variant.id %}selected{% endif %}
                              {% unless variant.available %}disabled{% endunless %}
                            >
                              {{ variant.title }}
                            </option>
                          {% endfor %}
                        </select>
                      </div>
                    {% endif %}

                    <input type="hidden" name="id" value="{{ stl_variant.id }}" data-stl-variant-id>
                    <button
                      type="submit"
                      class="btn btn--atc shop-the-look__add"
                      data-stl-add-button
                      {% if stl_product.variants.size > 1 %}
                        {% unless stl_product.available %}disabled{% endunless %}
                      {% else %}
                        {% unless stl_variant.available %}disabled{% endunless %}
                      {% endif %}
                    >
                      <span
                        class="btn-icon"
                        aria-hidden="true"
                        {% if stl_product.variants.size > 1 %}
                          hidden
                        {% else %}
                          {% unless stl_variant.available %}hidden{% endunless %}
                        {% endif %}
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                        </svg>
                      </span>
                      <span class="btn-text" data-stl-add-text>
                        {% if stl_product.variants.size > 1 %}
                          {% if stl_product.available %}Choose options{% else %}Sold out{% endif %}
                        {% else %}
                          {% if stl_variant.available %}Add to cart{% else %}Sold out{% endif %}
                        {% endif %}
                      </span>
                    </button>
                  </form>
                </div>

                <div class="shop-the-look__card-meta">
                  <h3 class="shop-the-look__product-title"><a href="{{ stl_product.url }}">{{ stl_product.title }}</a></h3>
                  {% render 'price',
                    amount: stl_variant.price,
                    compare_amount: stl_variant.compare_at_price,
                    wrapper_class: 'shop-the-look__price-line price--feature',
                    current_class: 'shop-the-look__price-value',
                    compare_class: 'shop-the-look__price-compare',
                    current_attrs: 'data-stl-price',
                    compare_attrs: 'data-stl-compare',
                    always_render_compare: true
                  %}
                </div>
              </article>
              {% assign stl_card_index = stl_card_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{% endif %}
